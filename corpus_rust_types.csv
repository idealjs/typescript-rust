genericDefaults,2124,"//// [tests/cases/compiler/genericDefaults.ts] ////\n\n=== genericDefaults.ts ===\ninterface A { a: number; }\n>a : A\n\ninterface B { b: number; }\n>b : B\n\ninterface C { c: number; }\n>c : C\n\ninterface D { d: number; }\n>d : D\n\ninterface AB { a: number; b: number; }\n>a : A\n>b : B\n\ninterface BC { b: number; c: number; }\n>b : B\n>c : C\n\ndeclare const a: A;\n>a : A\n\ndeclare const b: B;\n>b : B\n\ndeclare const c: C;\n>c : C\n\ndeclare const d: D;\n>d : D\n\ndeclare const ab: AB;\n>ab : AB\n\ndeclare const bc: BC;\n>bc : BC\n\ndeclare const x: any;\n>x : any\n\n// function without type parameters\ndeclare function f00(a?: A): A;\n>f00 : (a?: A | undefined) => A\n>a : A | undefined\n\n// no inference\nf00();\n>f00() : A\n>f00 : (a?: A | undefined) => A\n\nf00(a);\n>f00(a) : A\n>f00 : (a?: A | undefined) => A\n>a : A\n\n// function with a type parameter without a default\ndeclare function f01<T>(a?: T): T;\n>f01 : <T>(a?: T | undefined) => T\n>T : any\n>a : T | undefined\n\n// inference\nf01();\n>f01() : unknown\n>f01 : <T>(a?: T | undefined) => T\n\nf01(a);\n>f01(a) : A\n>f01 : <T>(a?: T | undefined) => T\n>a : A\n\n// no inference, fully supplied\nf01<A>();\n>f01<A>() : A\n>f01 : <T>(a?: T | undefined) => T\n\nf01<A>(a);\n>f01<A>(a) : A\n>f01 : <T>(a?: T | undefined) => T\n>a : A\n\n// function with a type paramter with a default\ndeclare function f02<T = A>(a?: T): T;\n>f02 : <T>(a?: T | undefined) => T\n>T : any\n>a : T | undefined\n\n// inference\nf02();\n>f02() : unknown\n>f02 : <T>(a?: T | undefined) => T\n\nf02(a);\n>f02(a) : A\n>f02 : <T>(a?: T | undefined) => T\n>a : A\n\nf02(b);\n>f02(b) : B\n>f02 : <T>(a?: T | undefined) => T\n>b : B\n\n// no inference, fully supplied\nf02<A>();\n>f02<A>() : A\n>f02 : <T>(a?: T | undefined) => T\n\nf02<A>(a);\n>f02<A>(a) : A\n>f02 : <T>(a?: T | undefined) => T\n>a : A\n\nf02<B>();\n>f02<B>() : B\n>f02 : <T>(a?: T | undefined) => T\n\nf02<B>(b);\n>f02<B>(b) : B\n>f02 : <T>(a?: T | undefined) => T\n>b : B\n\n// function with a type parameter with a default that refers to itself\ndeclare function f03<T = T>(a?: T): T;\n>f03 : <T>(a?: T | undefined) => T\n>T : any\n>a : T | undefined\n\n// inference\nf03();\n>f03() : unknown\n>f03 : <T>(a?: T | undefined) => T\n\nf03(a);\n>f03(a) : A\n>f03 : <T>(a?: T | undefined) => T\n>a : A\n\nf03(b);\n>f03(b) : B\n>f03 : <T>(a?: T | undefined) => T\n>b : B\n\n// no inference, fully supplied\nf03<A>();\n>f03<A>() : A\n>f03 : <T>(a?: T | undefined) => T\n\nf03<A>(a);\n>f03<A>(a) : A\n>f03 : <T>(a?: T | undefined) => T\n>a : A\n\nf03<B>();\n>f03<B>() : B\n>f03 : <T>(a?: T | undefined) => T\n\nf03<B>(b);\n>f03<B>(b) : B\n>f03 : <T>(a?: T | undefined) => T\n>b : B\n\n// function with a type paramter without a default and a type parameter with a default\ndeclare function f04<T, U = B>(a?: T, b?: U): [T, U];\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n>T : any\n>U : any\n>a : T | undefined\n>b : U | undefined\n\n// inference\nf04();\n>f04() : [unknown, unknown]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n\nf04(a);\n>f04(a) : [A, unknown]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n>a : A\n\nf04(a, b);\n>f04(a, b) : [A, B]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n>a : A\n>b : B\n\nf04(a, c);\n>f04(a, c) : [A, C]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n>a : A\n>c : C\n\n// no inference, partially supplied\nf04<A>();\n>f04<A>() : [unknown, unknown]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n\nf04<A>(a);\n>f04<A>(a) : [A, unknown]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n>a : A\n\nf04<A>(a, b);\n>f04<A>(a, b) : [A, B]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n>a : A\n>b : B\n\n// no inference, fully supplied\nf04<A, B>();\n>f04<A, B>() : [A, B]\n>f04 : <T, U>(a?: T | undefined, b?: U | undefined) => [T, U]\n\nf04<A, B>(a);\n>f04<A, B>(a) : [A, B]\n>f04 : <T,