syntheticProtectedProperties,318,"//// [tests/cases/compiler/syntheticProtectedProperties.ts] ////\n\n=== syntheticProtectedProperties.ts ===\n// https://github.com/microsoft/TypeScript/issues/63749\n\ndeclare class Dummy {\n>Dummy : typeof Dummy\n\n    a: number;\n>a : any\n}\n\ntype Public = Base | Dummy;\n>Public : Public\n\ndeclare class Base {\n>Base : typeof Base\n\n    protected get content(): string;\n>content : any\n\n    protected set content(value: string);\n>content : any\n>value : string\n}\n\ndeclare class Mock {\n>Mock : typeof Mock\n\n    get content(): string;\n>content : any\n\n    set content(value: string);\n>content : any\n>value : string\n}\n\ndeclare const w: Public\n>w : Public\n\nif (w instanceof Mock) {\n>w instanceof Mock : boolean\n>w : Public\n>Mock : typeof Mock\n\n    w.content;\n>w.content : any\n>w : never\n>content : any\n}\ndeclare const w2: Mock & Public\n>w2 : Mock & Public\n\nw2.content;\n>w2.content : string\n>w2 : Mock & Public\n>content : any\n\ndeclare const w3: Public & Mock\n>w3 : Public & Mock\n\nw3.content;\n>w3.content : string\n>w3 : Public & Mock\n>content : any\n\n// private/protected set accessors are tracked in unions and intersections\n\ndeclare class C1 {\n>C1 : typeof C1\n\n    get foo(): number;\n>foo : any\n\n    set foo(value: number);\n>foo : any\n>value : number\n}\n\ndeclare class C2 {\n>C2 : typeof C2\n\n    get foo(): number;\n>foo : any\n\n    protected set foo(value: number);\n>foo : any\n>value : number\n}\n\ndeclare class C3 {\n>C3 : typeof C3\n\n    protected get foo(): number;\n>foo : any\n\n    protected set foo(value: number);\n>foo : any\n>value : number\n}\n\ndeclare class P1 {\n>P1 : typeof P1\n\n    get foo(): number;\n>foo : any\n\n    set foo(value: number);\n>foo : any\n>value : number\n}\n\ndeclare class P2 {\n>P2 : typeof P2\n\n    get foo(): number;\n>foo : any\n\n    private set foo(value: number);\n>foo : any\n>value : number\n}\n\ndeclare class P3 {\n>P3 : typeof P3\n\n    private ge