generics2,59,"//// [tests/cases/compiler/generics2.ts] ////\n\n=== generics2.ts ===\ninterface A { a: string; }\n>a : any\n\ninterface B extends A { b: string; }\n>b : any\n\ninterface C extends B { c: string; }\n>c : any\n\ninterface G<T, U extends B> {\n>T : any\n>U : any\n\n    x: T;\n>x : any\n\n    y: U;\n>y : any\n}\n\n\nvar v1: {\n>v1 : { x: { a: string; }; y: { a: string; b: string; c: string; }; }\n\n    x: { a: string; }\n>x : any\n>a : any\n\n    y: { a: string; b: string; c: string };\n>y : any\n>a : any\n>b : any\n>c : any\n\n}; // Ok\n\n\nvar v2: G<{ a: string }, C>;   // Ok, equivalent to G<A, C>\n>v2 : G<{ a: string; }, C>\n>a : any\n\nvar v3: G<A, A>;               // Error, A not valid argument for U\n>v3 : G<A, A>\n\nvar v4: G<G<A, B>, C>;         // Ok\n>v4 : G<G<A, B>, C>\n\nvar v5: G<any, any>;           // Error, any does not satisfy constraint B\n>v5 : G<any, any>\n\nvar v6: G<any>;                // Error, wrong number of arguments\n>v6 : any\n\nvar v7: G;                     // Error, no type arguments\n>v7 : any\n\n"
