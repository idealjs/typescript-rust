eof M.C\n>y : any\n>C.pub : number\n>C : typeof M.C\n>pub : any\n>C.priv : number\n>C : typeof M.C\n>priv : any\n\n        }        \n    }\n    var c=C.y;\n>c : number\n>C.y : number\n>C : typeof M.C\n>y : any\n\n    export function f() {\n>f : () => string\n\n        var result="""";\n>result : string\n>"""" : """"\n\n        result+=(c);\n>result+=(c) : string\n>result : string\n>(c) : number\n>c : number\n\n        result+=(new C(0,1,2).x);\n>result+=(new C(0,1,2).x) : string\n>result : string\n>(new C(0,1,2).x) : number\n>new C(0,1,2).x : number\n>new C(0,1,2 : M.C\n>C : typeof M.C\n>0 : 0\n>1 : 1\n>2 : 2\n>x : any\n\n        result+=(C.f(10));\n>result+=(C.f(10)) : string\n>result : string\n>(C.f(10)) : string\n>C.f(10) : string\n>C.f : (n: number) => string\n>C : typeof M.C\n>f : () => string\n>10 : 10\n\n        result+=(new C(5,10,20).g(C.y));\n>result+=(new C(5,10,20).g(C.y)) : string\n>result : string\n>(new C(5,10,20).g(C.y)) : any\n>new C(5,10,20).g(C.y) : any\n>new C(5,10,20).g : any\n>new C(5,10,20 : M.C\n>C : typeof M.C\n>5 : 5\n>10 : 10\n>20 : 20\n>g : any\n>C.y : number\n>C : typeof M.C\n>y : any\n\n        return result;\n>result : string\n    }\n}\n\nM.f();\n>M.f() : string\n>M.f : () => string\n>M : typeof M\n>f : any\n\n\n\n"
