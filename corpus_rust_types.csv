classPropertyInferenceFromBroaderTypeConst,74,"//// [tests/cases/compiler/classPropertyInferenceFromBroaderTypeConst.ts] ////\n\n=== classPropertyInferenceFromBroaderTypeConst.ts ===\n// Repro from GH#62264\n// Class property should infer the wider declared type (AB), not the narrowed literal type (""A"")\n\ntype AB = 'A' | 'B';\n>AB : AB\n\nconst DEFAULT: AB = 'A';\n>DEFAULT : AB\n>'A' : ""A""\n\nclass C {\n>C : typeof C\n\n    D = DEFAULT;\n>D : typeof D\n>DEFAULT : AB\n\n    method() {\n>method : any\n\n        switch (this.D) {\n>this.D : AB\n>this : this\n>D : typeof D\n\n            case 'A': break;\n>'A' : ""A""\n\n            case 'B': break; // should not error\n>'B' : ""B""\n        }\n    }\n}\n\n// D should be AB, not ""A""\ndeclare const c: C;\n>c : C\n\ndeclare function expectAB(x: AB): void;\n>expectAB : (x: AB) => void\n>x : AB\n\nexpectAB(c.D); // ok\n>expectAB(c.D) : void\n>expectAB : (x: AB) => void\n>c.D : AB\n>c : C\n>D : typeof D\n\nc.D = 'B'; // ok\n>c.D = 'B' : ""B""\n>c.D : AB\n>c : C\n>D : typeof D\n>'B' : ""B""\n\n// Static property should work the same way\nclass D {\n>D : typeof D\n\n    static SD = DEFAULT;\n>SD : any\n>DEFAULT : AB\n}\nD.SD = 'B'; // ok\n>D.SD = 'B' : ""B""\n>D.SD : AB\n>D : typeof D\n>SD : any\n>'B' : ""B""\n\n"
