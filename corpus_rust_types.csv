enumLiteralAssignableToEnumInsideUnion,122,"//// [tests/cases/compiler/enumLiteralAssignableToEnumInsideUnion.ts] ////\n\n=== enumLiteralAssignableToEnumInsideUnion.ts ===\nnamespace X {\n>X : typeof X\n\n    export enum Foo {\n>Foo : typeof X.Foo\n\n        A, B\n>A : Foo.A\n>B : Foo.B\n    }\n}\nnamespace Y {\n>Y : typeof Y\n\n    export enum Foo {\n>Foo : typeof Y.Foo\n\n        A, B\n>A : Foo.A\n>B : Foo.B\n    }\n}\nnamespace Z {\n>Z : typeof Z\n\n    export enum Foo {\n>Foo : typeof Z.Foo\n\n        A = 1 << 1,\n>A : Foo.A\n>1 << 1 : number\n>1 : 1\n>1 : 1\n\n        B = 1 << 2,\n>B : Foo.B\n>1 << 2 : number\n>1 : 1\n>2 : 2\n    }\n}\nnamespace Ka {\n>Ka : typeof Ka\n\n    export enum Foo {\n>Foo : typeof Ka.Foo\n\n        A = 1 << 10,\n>A : Foo.A\n>1 << 10 : number\n>1 : 1\n>10 : 10\n\n        B = 1 << 11,\n>B : Foo.B\n>1 << 11 : number\n>1 : 1\n>11 : 11\n    }\n}\nconst e0: X.Foo | boolean = Y.Foo.A; // ok\n>e0 : boolean | Foo\n>X : typeof X\n>Y.Foo.A : Foo.A\n>Y.Foo : typeof Y.Foo\n>Y : typeof Y\n>Foo : any\n>A : any\n\nconst e1: X.Foo | boolean = Z.Foo.A; // not legal, Z is computed\n>e1 : boolean | Foo\n>X : typeof X\n>Z.Foo.A : Foo.A\n>Z.Foo : typeof Z.Foo\n>Z : typeof Z\n>Foo : any\n>A : any\n\nconst e2: X.Foo.A | X.Foo.B | boolean = Z.Foo.A; // still not legal\n>e2 : boolean | Foo.A | Foo.B\n>X : typeof X\n>Foo : any\n>X : typeof X\n>Foo : any\n>Z.Foo.A : Foo.A\n>Z.Foo : typeof Z.Foo\n>Z : typeof Z\n>Foo : any\n>A : any\n\nconst e3: X.Foo.B | boolean = Z.Foo.A; // not legal\n>e3 : boolean | Foo.B\n>X : typeof X\n>Foo : any\n>Z.Foo.A : Foo.A\n>Z.Foo : typeof Z.Foo\n>Z : typeof Z\n>Foo : any\n>A : any\n\nconst e4: X.Foo.A | boolean = Z.Foo.A; // not legal either because Z.Foo is computed and Z.Foo.A is not necessarily assignable to X.Foo.A\n>e4 : boolean | Foo.A\n>X : typeof X\n>Foo : any\n>Z.Foo.A : Foo.A\n>Z.Foo : typeof Z.Foo\n>Z : typeof Z\n>Foo : any\n>A : any\n\nconst e5: Ka.Foo | boolean = Z.Foo.A; // ok\n>e5 : boolean | Foo\n>Ka : typeof Ka\n>Z.Foo.A : Foo.A\n>Z.Foo : typeof Z.Foo\n>Z : typeof Z\n>Foo : any\n>A : any\n\n"
enumLiteralUnionNotWidened,58,"//// [tests/cases/compiler/enumLiteralUnionNotWidened.ts] ////\n\n=== enumLiteralUnionNotWidened.ts ===\n// repro from #22093\nenum A { one = ""one"", two = ""two"" };\n>A : typeof A\n>one : A.one\n>""one"" : ""one""\n>two : A.two\n>""two"" : ""two""\n\nenum B { foo = ""foo"", bar = ""bar"" };\n>B : typeof B\n>foo : B.foo\n>""foo"" : ""foo""\n>bar : B.bar\n>""bar"" : ""bar""\n\ntype C = A | B.foo;\n>C : C\n>B : typeof B\n\ntype D = A | ""foo"";\n>D : D\n\nclass List<T>\n>List : typeof List\n>T : any\n{\n	private readonly items: T[] = [];\n>items : any\n>[] : never[]\n}\n\nfunction asList<T>(arg: T): List<T> { return new List(); }\n>asList : <T>(arg: T) => List<T>\n>T : any\n>arg : T\n>new List( : List<never>\n>List : typeof List\n\n// TypeScript incorrectly infers the return type of ""asList(x)"" to be ""List<A | B>""\n// The correct type is ""List<A | B.foo>""\nfunction fn1(x: C): List<C> { return asList(x); }\n>fn1 : (x: C) => List<C>\n>x : C\n>asList(x) : List<A.one | A.two | B.foo | B.bar>\n>asList : <T>(arg: T) => List<T>\n>x : C\n\n// If we use the literal ""foo"" instead of B.foo, the correct type is inferred\nfunction fn2(x: D): List<D> { return asList(x); }\n>fn2 : (x: D) => List<D>\n>x : D\n>asList(x) : List<D>\n>asList : <T>(arg: T) => List<T>\n>x : D\n\n"
