duplicateIdentifiersAcrossContainerBoundaries,100,"//// [tests/cases/compiler/duplicateIdentifiersAcrossContainerBoundaries.ts] ////\n\n=== duplicateIdentifiersAcrossContainerBoundaries.ts ===\nnamespace M {\n>M : typeof M\n\n    export interface I { }\n}\nnamespace M {\n>M : typeof M\n\n    export class I { }\n>I : typeof M.I\n}\n\nnamespace M {\n>M : typeof M\n\n    export function f() { }\n>f : typeof M.f\n}\nnamespace M {\n>M : typeof M\n\n    export class f { } // error\n>f : typeof M.f\n}\n\nnamespace M {\n>M : typeof M\n\n    function g() { }\n>g : () => void\n}\nnamespace M {\n>M : typeof M\n\n    export class g { } // no error\n>g : typeof M.g\n}\n\nnamespace M {\n>M : typeof M\n\n    export class C { }\n>C : typeof M.C\n}\nnamespace M {\n>M : typeof M\n\n    function C() { } // no error\n>C : () => void\n}\n\nnamespace M {\n>M : typeof M\n\n    export var v = 3;\n>v : number\n>3 : 3\n}\nnamespace M {\n>M : typeof M\n\n    export var v = 3; // error for redeclaring var in a different parent\n>v : number\n>3 : 3\n}\n\nclass Foo {\n>Foo : Foo\n\n    static x: number;\n>x : any\n}\n\nnamespace Foo {\n>Foo : Foo\n\n    export var x: number; // error for redeclaring var in a different parent\n>x : any\n}\n\nnamespace N {\n>N : typeof N\n\n    export namespace F {\n>F : typeof F\n\n        var t;\n>t : any\n    }\n}\ndeclare namespace N {\n>N : typeof N\n\n    export function F(); // no error because function is ambient\n>F : typeof F\n}\n\n"
