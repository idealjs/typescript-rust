inferConditionalConstraintMappedMember,31,"//// [tests/cases/compiler/inferConditionalConstraintMappedMember.ts] ////\n\n=== inferConditionalConstraintMappedMember.ts ===\n// Return keyof type without string index signature\ntype KeysWithoutStringIndex<T> =\n>KeysWithoutStringIndex : KeysWithoutStringIndex\n>T : any\n\n    { [K in keyof T]: string extends K ? never : K } extends { [_ in keyof T]: infer U }\n>K : any\n>_ : any\n>U : any\n\n    ? U\n    : never\n\n// Only ""foo"" | ""bar"" as expected, [string] index signature removed\ntype test = KeysWithoutStringIndex<{ [index: string]: string; foo: string; bar: 'baz' }>\n>test : test\n>index : any\n>foo : any\n>bar : any\n\n// KeysWithoutStringIndex<T> will always be a subset of keyof T, but is reported as unassignable\nexport type RemoveIdxSgn<T> = Pick<T, KeysWithoutStringIndex<T>>\n>RemoveIdxSgn : RemoveIdxSgn\n>T : any\n\n  // ERROR:\n  // Type 'KeysWithoutStringIndex<T>' does not satisfy the constraint 'keyof T'.\n  //  Type 'unknown' is not assignable to type 'keyof T'.(2344)\n"
inferFromAnnotatedReturn1,93,"//// [tests/cases/compiler/inferFromAnnotatedReturn1.ts] ////\n\n=== inferFromAnnotatedReturn1.ts ===\ndeclare function test<T>(cb: (arg: T) => T): T;\n>test : <T>(cb: (arg: T) => T) => T\n>T : any\n>cb : (arg: T) => T\n>arg : T\n\nconst res1 = test((arg): number => 1); // ok\n>res1 : number\n>test((arg): number => 1) : number\n>test : <T>(cb: (arg: T) => T) => T\n>(arg): number => 1 : (arg: unknown) => number\n>arg : unknown\n>1 : 1\n\nconst res2 = test((arg): number => 'foo'); // error\n>res2 : number\n>test((arg): number => 'foo') : number\n>test : <T>(cb: (arg: T) => T) => T\n>(arg): number => 'foo' : (arg: unknown) => number\n>arg : unknown\n>'foo' : ""foo""\n\nexport declare function linkedSignal<S, D>(options: {\n>linkedSignal : <S, D>(options: { source: () => S; computation: (source: NoInfer<D>) => D; }) => D\n>S : any\n>D : any\n>options : { source: () => S; computation: (source: NoInfer<D>) => D; }\n\n  source: () => S;\n>source : any\n\n  computation: (source: NoInfer<D>) => D;\n>computation : any\n>source : NoInfer<D>\n\n}): D;\n\nconst signal = linkedSignal({\n>signal : number\n>linkedSignal({  source: () => 3,  computation: (s): number => 3,}) : number\n>linkedSignal : <S, D>(options: { source: () => S; computation: (source: NoInfer<D>) => D; }) => D\n>{  source: () => 3,  computation: (s): number => 3,} : { source: () => number; computation: (s: NoInfer<D>) => number; }\n\n  source: () => 3,\n>source : any\n>() => 3 : () => number\n>3 : 3\n\n  computation: (s): number => 3,\n>computation : any\n>(s): number => 3 : (s: NoInfer<D>) => number\n>s : NoInfer<D>\n>3 : 3\n\n});\n\nclass Foo<T, R> {\n>Foo : typeof Foo\n>T : any\n>R : any\n\n  constructor(readonly cb: (t: T, _: { x: number; other: NoInfer<R> }) => R) {}\n>cb : (t: T, _: { x: number; other: NoInfer<R>; }) => R\n>t : T\n>_ : { x: number; other: NoInfer<R>; }\n>x : any\n>other : any\n}\n\nconst _1 = new Foo((name: string, { x }): { name: string; x: number } => ({\n>_