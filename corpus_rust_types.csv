strictBestCommonSupertype,50,"//// [tests/cases/compiler/strictBestCommonSupertype.ts] ////\n\n=== strictBestCommonSupertype.ts ===\n// https://github.com/microsoft/TypeScript/tsc/issues/1222\n\nclass Store<T = object> {\n>Store : typeof Store\n>T : any\n\n    select<K>(mapFn: (state: T) => K) {};\n>select : any\n>K : any\n>mapFn : (state: T) => K\n>state : T\n}\n\nconst store: Store = inject(Store);\n>store : Store<T>\n>inject(Store) : Store<any>\n>inject : <T>(token: ProviderToken<T>) => T\n>Store : typeof Store\n\nfunction inject<T>(token: ProviderToken<T>): T {\n>inject : <T>(token: ProviderToken<T>) => T\n>T : any\n>token : ProviderToken<T>\n\n    return {} as T;\n>{} as T : T\n>{} : {}\n}\n\ninterface Type<T> extends Function {\n>T : any\n\n    new (...args: any[]): T;\n>args : any[]\n}\n\ntype ProviderToken<T> = Type<T> | AbstractType<T>;\n>ProviderToken : ProviderToken\n>T : any\n\ninterface AbstractType<T> extends Function {\n>T : any\n\n    prototype: T;\n>prototype : any\n}\n\n"
