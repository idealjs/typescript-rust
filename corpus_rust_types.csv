overloadModifiersMustAgree,35,"//// [tests/cases/compiler/overloadModifiersMustAgree.ts] ////\n\n=== overloadModifiersMustAgree.ts ===\nclass baz {\n>baz : typeof baz\n\n    public foo();\n>foo : any\n\n    private foo(bar?: any) { } // error - access modifiers do not agree\n>foo : any\n>bar : any\n}\n\ndeclare function bar();\n>bar : { (): any; (s: string): any; }\n\nexport function bar(s: string);\n>bar : { (): any; (s: string): any; }\n>s : string\n\nfunction bar(s?: string) { }\n>bar : { (): any; (s: string): any; }\n>s : string\n\ninterface I {\n    foo? ();\n>foo : any\n\n    foo(s: string);\n>foo : any\n>s : string\n}\n\n\n"
