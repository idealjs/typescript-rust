classFieldsPropertyAccessSameNameAsClass,139,"//// [tests/cases/compiler/classFieldsPropertyAccessSameNameAsClass.ts] ////\n\n=== classFieldsPropertyAccessSameNameAsClass.ts ===\nexport enum MyEnum {\n>MyEnum : typeof MyEnum\n\n    Foo = ""FooValue"",\n>Foo : MyEnum.Foo\n>""FooValue"" : ""FooValue""\n\n    Bar = ""BarValue"",\n>Bar : MyEnum.Bar\n>""BarValue"" : ""BarValue""\n}\n\n// Class declarations with self-reference - alias is same-name, so bug is invisible\n// but these still serve as regression tests\nexport class Foo {\n>Foo : typeof Foo\n\n    static instance = new Foo();\n>instance : any\n>new Foo( : Foo\n>Foo : typeof Foo\n\n    type: MyEnum = MyEnum.Foo;\n>type : any\n>MyEnum.Foo : MyEnum.Foo\n>MyEnum : typeof MyEnum\n>Foo : typeof Foo\n\n    getType(): MyEnum {\n>getType : any\n\n        return this.type || MyEnum.Foo;\n>this.type || MyEnum.Foo : MyEnum\n>this.type : MyEnum\n>this : this\n>type : any\n>MyEnum.Foo : MyEnum.Foo\n>MyEnum : typeof MyEnum\n>Foo : typeof Foo\n    }\n}\n\ndeclare const obj: { Bar: string };\n>obj : { Bar: string; }\n>Bar : typeof Bar\n\nexport class Bar {\n>Bar : typeof Bar\n\n    static instance = new Bar();\n>instance : any\n>new Bar( : Bar\n>Bar : typeof Bar\n\n    prop = obj.Bar;\n>prop : any\n>obj.Bar : string\n>obj : { Bar: string; }\n>Bar : typeof Bar\n\n    method() {\n>method : any\n\n        return obj.Bar;\n>obj.Bar : string\n>obj : { Bar: string; }\n>Bar : typeof Bar\n    }\n}\n\nclass Other {\n>Other : typeof Other\n\n    static Baz = 42;\n>Baz : typeof Baz\n>42 : 42\n}\n\nexport class Baz {\n>Baz : typeof Baz\n\n    static instance = new Baz();\n>instance : any\n>new Baz( : Baz\n>Baz : typeof Baz\n\n    prop = Other.Baz;\n>prop : any\n>Other.Baz : number\n>Other : typeof Other\n>Baz : typeof Baz\n}\n\n// Class EXPRESSION with self-reference and transformable static fields.\n// At target < ES2022, the class fields transformer creates a temp variable alias,\n// so property access names must not be incorrectly subst