indexedAccessCanBeHighOrder,64,"//// [tests/cases/compiler/indexedAccessCanBeHighOrder.ts] ////\n\n=== indexedAccessCanBeHighOrder.ts ===\ndeclare function get<U, Y extends keyof U>(x: U, y: Y): U[Y];\n>get : <U, Y extends keyof U>(x: U, y: Y) => U[Y]\n>U : any\n>Y : any\n>x : U\n>y : Y\n\ndeclare function find<T, K extends keyof T>(o: T[K]): [T, K];\n>find : <T, K extends keyof T>(o: T[K]) => [T, K]\n>T : any\n>K : any\n>o : T[K]\n\nfunction impl<A, B extends keyof A>(a: A, b: B) {\n>impl : <A, B extends keyof A>(a: A, b: B) => [A, B]\n>A : any\n>B : any\n>a : A\n>b : B\n\n    const item = get(a, b);\n>item : A[B]\n>get(a, b) : A[B]\n>get : <U, Y extends keyof U>(x: U, y: Y) => U[Y]\n>a : A\n>b : B\n\n    return find(item);\n>find(item) : [A, B]\n>find : <T, K extends keyof T>(o: T[K]) => [T, K]\n>item : A[B]\n}\n\nconst o = {x: 42};\n>o : { x: number; }\n>{x: 42} : { x: number; }\n>x : any\n>42 : 42\n\nconst r = impl(o, ""x"");\n>r : [{ x: number; }, ""x""]\n>impl(o, ""x"") : [{ x: number; }, ""x""]\n>impl : <A, B extends keyof A>(a: A, b: B) => [A, B]\n>o : { x: number; }\n>""x"" : ""x""\n\nr[0][r[1]] = o[r[1]];\n>r[0][r[1]] = o[r[1]] : number\n>r[0][r[1]] : number\n>r[0] : { x: number; }\n>r : [{ x: number; }, ""x""]\n>0 : 0\n>r[1] : ""x""\n>r : [{ x: number; }, ""x""]\n>1 : 1\n>o[r[1]] : number\n>o : { x: number; }\n>r[1] : ""x""\n>r : [{ x: number; }, ""x""]\n>1 : 1\n\n"
indexedAccessConstraints,62,"//// [tests/cases/compiler/indexedAccessConstraints.ts] ////\n\n=== indexedAccessConstraints.ts ===\nfunction foo<T extends object>(a: T[keyof T]) {\n>foo : <T extends object>(a: T[keyof T]) => void\n>T : any\n>a : T[keyof T]\n\n    let b: number = a;  // Error\n>b : number\n>a : T[keyof T]\n}\n\n// Repro from #54522\n\nexport function methodFnLength<T extends {}, K extends keyof T>(obj: T, methodKey: K): number {\n>methodFnLength : <T extends {}, K extends keyof T>(obj: T, methodKey: K) => number\n>T : any\n>K : any\n>obj : T\n>methodKey : K\n\n    const fn = obj[methodKey];\n>fn : any\n>obj[methodKey] : any\n>obj : T\n>methodKey : K\n\n    if (typeof fn !== 'function') {\n>typeof fn !== 'function' : boolean\n>typeof fn : ""bigint"" | ""boolean"" | ""function"" | ""number"" | ""object"" | ""string"" | ""symbol"" | ""undefined""\n>fn : any\n>'function' : ""function""\n\n        return 0;\n    }\n    return fn.length;\n>fn.length : any\n>fn : any\n>length : number\n}\n\n// Repro from #54837\n\nfunction getField<T extends object>(x: T | null, k: keyof T) {\n>getField : <T extends object>(x: T | null, k: keyof T) => T[keyof T] | null\n>T : any\n>x : T | null\n>k : keyof T\n\n    const result = x ? x[k] : null;\n>result : T[keyof T] | null\n>x ? x[k] : null : T[keyof T] | null\n>x : T | null\n>x[k] : T[keyof T]\n>x : T | null\n>k : keyof T\n\n    return result;  // T[keyof T] | null\n>result : T[keyof T] | null\n}\n\n"
