inheritedStringIndexersFromDifferentBaseTypes,37,"//// [tests/cases/compiler/inheritedStringIndexersFromDifferentBaseTypes.ts] ////\n\n=== inheritedStringIndexersFromDifferentBaseTypes.ts ===\n// string indexer tests\ninterface A {\n    [s: string]: number;\n>s : any\n}\ninterface B {\n    [s: string]: number;\n>s : any\n}\ninterface C extends A, B { } // ok\n\ninterface D {\n    [s: string]: string;\n>s : any\n}\ninterface E extends A, D { } // error\n\n\n// Same tests for number indexer\ninterface A2 {\n    [s: number]: number;\n>s : any\n}\ninterface B2 {\n    [s: number]: number;\n>s : any\n}\ninterface C2 extends A2, B2 { } // ok\n\ninterface D2 {\n    [s: number]: string;\n>s : any\n}\ninterface E2 extends A2, D2 { } // error\n"
