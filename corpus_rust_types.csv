indexerConstraints,61,"//// [tests/cases/compiler/indexerConstraints.ts] ////\n\n=== indexerConstraints.ts ===\ninterface A { a: number; }\n>a : any\n\ninterface B extends A { b: number; }\n>b : any\n\n// Good case\ninterface D {\n    [s: string]: A;\n>s : any\n}\ninterface D {\n    [n: number]: B;\n>n : any\n}\n\n// Bad case\ninterface E {\n    [s: string]: B;\n>s : any\n}\ninterface E {\n    [n: number]: A;\n>n : any\n}\n\n// Inheritance\ninterface F {\n    [s: string]: B;\n>s : any\n}\ninterface G extends F {\n    [n: number]: A;\n>n : any\n}\n\n// Other way\ninterface H {\n    [n: number]: A;\n>n : any\n}\ninterface I extends H {\n    [s: string]: B;\n>s : any\n}\n\n// With hidden indexer\ninterface J {\n    [n: number]: {};\n>n : any\n}\ninterface K extends J {\n    [n: number]: A;\n>n : any\n\n    [s: string]: B;\n>s : any\n}\n"
