promiseIdentity,59,"//// [tests/cases/compiler/promiseIdentity.ts] ////\n\n=== promiseIdentity.ts ===\nexport interface IPromise<T> {\n>T : any\n\n    then<U>(callback: (x: T) => IPromise<U>): IPromise<U>;\n>then : any\n>U : any\n>callback : (x: T) => IPromise<U>\n>x : T\n}\ninterface Promise<T> {\n>T : any\n\n    then<U>(callback: (x: T) => Promise<U>): Promise<U>;\n>then : any\n>U : any\n>callback : (x: T) => Promise<U>\n>x : T\n}\nvar x: IPromise<string>;\n>x : IPromise<string>\n\nvar x: Promise<string>;\n>x : IPromise<string>\n\n\ninterface IPromise2<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => IPromise2<U, W>): IPromise2<W, U>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => IPromise2<U, W>\n>x : T\n}\ninterface Promise2<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: V) => Promise2<U, T>): Promise2<T, W>; // Uses V instead of T in callback's parameter\n>then : any\n>U : any\n>W : any\n>callback : (x: V) => Promise2<U, T>\n>x : V\n}\n\n// Ok because T in this particular Promise2 is any, as are all the U and W references.\n// Also, the V of Promise2 happens to coincide with the T of IPromise2 (they are both string).\nvar y: IPromise2<string, number>;\n>y : IPromise2<string, number>\n\nvar y: Promise2<any, string>;\n>y : IPromise2<string, number>\n\n"
promiseIdentity2,34,"//// [tests/cases/compiler/promiseIdentity2.ts] ////\n\n=== promiseIdentity2.ts ===\nexport interface IPromise<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => IPromise<U, W>): IPromise<U, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => IPromise<U, W>\n>x : T\n}\nexport interface Promise<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => Promise<T, U>): Promise<T, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => Promise<T, U>\n>x : T\n}\n\n// error because T is string in the first declaration, and T is boolean in the second\n// Return type and callback return type are ok because T is any in this particular Promise\nvar x: IPromise<string, number>;\n>x : IPromise<string, number>\n\nvar x: Promise<any, string>;\n>x : IPromise<string, number>\n\n"
promiseIdentityWithAny,33,"//// [tests/cases/compiler/promiseIdentityWithAny.ts] ////\n\n=== promiseIdentityWithAny.ts ===\nexport interface IPromise<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => IPromise<U, W>): IPromise<U, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => IPromise<U, W>\n>x : T\n}\nexport interface Promise<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => Promise<any, any>): Promise<any, any>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => Promise<any, any>\n>x : T\n}\n\n// Should be ok because signature type parameters get erased to any\nvar x: IPromise<string, number>;\n>x : IPromise<string, number>\n\nvar x: Promise<string, boolean>;\n>x : IPromise<string, number>\n\n"
promiseIdentityWithAny2,62,"//// [tests/cases/compiler/promiseIdentityWithAny2.ts] ////\n\n=== promiseIdentityWithAny2.ts ===\nexport interface IPromise<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => IPromise<U, W>): IPromise<U, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => IPromise<U, W>\n>x : T\n}\ninterface Promise<T, V> {\n>T : any\n>V : any\n\n    then(callback: (x: T) => Promise<any, any>): Promise<any, any>;\n>then : any\n>callback : (x: T) => Promise<any, any>\n>x : T\n}\n\n// Error because type parameter arity doesn't match\nvar x: IPromise<string, number>;\n>x : IPromise<string, number>\n\nvar x: Promise<string, boolean>;\n>x : IPromise<string, number>\n\n\ninterface IPromise2<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => IPromise2<U, W>): IPromise2<U, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => IPromise2<U, W>\n>x : T\n}\ninterface Promise2<T, V> {\n>T : any\n>V : any\n\n    then<U, W>(callback: (x: T) => Promise2<string, any>): Promise2<any, any>; // Uses string instead of any!\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => Promise2<string, any>\n>x : T\n}\n\n// Error because string and any don't match\nvar y: IPromise2<string, number>;\n>y : IPromise2<string, number>\n\nvar y: Promise2<string, boolean>;\n>y : IPromise2<string, number>\n\n"
promiseIdentityWithConstraints,33,"//// [tests/cases/compiler/promiseIdentityWithConstraints.ts] ////\n\n=== promiseIdentityWithConstraints.ts ===\nexport interface IPromise<T, V> {\n>T : any\n>V : any\n\n    then<U extends T, W extends V>(callback: (x: T) => IPromise<U, W>): IPromise<U, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => IPromise<U, W>\n>x : T\n}\nexport interface Promise<T, V> {\n>T : any\n>V : any\n\n    then<U extends T, W extends V>(callback: (x: T) => Promise<U, W>): Promise<U, W>;\n>then : any\n>U : any\n>W : any\n>callback : (x: T) => Promise<U, W>\n>x : T\n}\n\n// Error because constraint V doesn't match\nvar x: IPromise<string, number>;\n>x : IPromise<string, number>\n\nvar x: Promise<string, boolean>;\n>x : IPromise<string, number>\n\n"
