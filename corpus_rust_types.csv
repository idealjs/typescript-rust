typeArgumentInferenceOrdering,35,"//// [tests/cases/compiler/typeArgumentInferenceOrdering.ts] ////\n\n=== typeArgumentInferenceOrdering.ts ===\nclass C {\n>C : typeof C\n\n    y: I;\n>y : any\n}\n\ninterface I {\n    x(): Goo;\n>x : () => Goo\n}\n\ninterface Goo {\n    p: string;\n>p : any\n}\n\nfunction foo<T>(f: { y: T }): T { return null }\n>foo : <T>(f: { y: T; }) => T\n>T : any\n>f : { y: T; }\n>y : any\n\nvar x = foo(new C()).x; // was Error that property x does not exist on type {}\n>x : () => Goo\n>foo(new C()).x : () => Goo\n>foo(new C()) : I\n>foo : <T>(f: { y: T; }) => T\n>new C( : C\n>C : typeof C\n>x : () => Goo\n\n"
typeArgumentInferenceWithConstraintAsCommonRoot,30,"//// [tests/cases/compiler/typeArgumentInferenceWithConstraintAsCommonRoot.ts] ////\n\n=== typeArgumentInferenceWithConstraintAsCommonRoot.ts ===\ninterface Animal { x }\n>x : any\n\ninterface Giraffe extends Animal { y }\n>y : any\n\ninterface Elephant extends Animal { z }\n>z : any\n\nfunction f<T extends Animal>(x: T, y: T): T { return undefined; }\n>f : <T extends Animal>(x: T, y: T) => T\n>T : any\n>x : T\n>y : T\n\ndeclare var g: Giraffe;\n>g : Giraffe\n\ndeclare var e: Elephant;\n>e : Elephant\n\nf(g, e); // valid because both Giraffe and Elephant satisfy the constraint. T is Animal\n>f(g, e) : Giraffe\n>f : <T extends Animal>(x: T, y: T) => T\n>g : Giraffe\n>e : Elephant\n\n"
