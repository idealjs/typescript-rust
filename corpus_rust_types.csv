typeArgumentsOnFunctionsWithNoTypeParameters,33,"//// [tests/cases/compiler/typeArgumentsOnFunctionsWithNoTypeParameters.ts] ////\n\n=== typeArgumentsOnFunctionsWithNoTypeParameters.ts ===\nfunction foo<T, U>(f: (v: T) => U) {\n>foo : <T, U>(f: (v: T) => U) => void\n>T : any\n>U : any\n>f : (v: T) => U\n>v : T\n\n   var r1 = f<number>(1);\n>r1 : U\n>f<number>(1) : U\n>f : (v: T) => U\n>1 : 1\n\n   var r2 = f(1);\n>r2 : U\n>f(1) : U\n>f : (v: T) => U\n>1 : 1\n\n   var r3 = f<any>(null);\n>r3 : U\n>f<any>(null) : U\n>f : (v: T) => U\n\n   var r4 = f(null);\n>r4 : U\n>f(null) : U\n>f : (v: T) => U\n}\n\n"
