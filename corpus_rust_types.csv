genericWithNoConstraintComparableWithCurlyCurly,80,"//// [tests/cases/compiler/genericWithNoConstraintComparableWithCurlyCurly.ts] ////\n\n=== genericWithNoConstraintComparableWithCurlyCurly.ts ===\nfunction foo<T>() {\n>foo : <T>() => void\n>T : any\n\n    let x = {};\n>x : {}\n>{} : {}\n\n    x as T;\n>x as T : T\n>x : {}\n}\n\nfunction bar<T extends unknown>() {\n>bar : <T extends unknown>() => void\n>T : any\n\n    let x = {};\n>x : {}\n>{} : {}\n\n    x as T;\n>x as T : T\n>x : {}\n}\n\nfunction baz<T extends {}>() {\n>baz : <T extends {}>() => void\n>T : any\n\n    let x = {};\n>x : {}\n>{} : {}\n\n    x as T;\n>x as T : T\n>x : {}\n}\n\nfunction bat<T extends object>() {\n>bat : <T extends object>() => void\n>T : any\n\n    let x = {};\n>x : {}\n>{} : {}\n\n    x as T;\n>x as T : T\n>x : {}\n}\n\nfunction no<T extends null | undefined>() {\n>no : <T extends null | undefined>() => void\n>T : any\n\n    let x = {};\n>x : {}\n>{} : {}\n\n    x as T; // should error\n>x as T : T\n>x : {}\n}\n\nfunction yes<T extends object | null | undefined>() {\n>yes : <T extends object | null | undefined>() => void\n>T : any\n\n    let x = {};\n>x : {}\n>{} : {}\n\n    x as T;\n>x as T : T\n>x : {}\n}\n"
genericWithOpenTypeParameters1,65,"//// [tests/cases/compiler/genericWithOpenTypeParameters1.ts] ////\n\n=== genericWithOpenTypeParameters1.ts ===\nclass B<T> {\n>B : typeof B\n>T : any\n\n   foo(x: T): T { return null; }\n>foo : any\n>x : T\n}\n\ndeclare var x: B<number>;\n>x : B<number>\n\nx.foo(1); // no error\n>x.foo(1) : number\n>x.foo : (x: number) => number\n>x : B<number>\n>foo : any\n>1 : 1\n\nvar f = <T>(x: B<T>) => { return x.foo(1); } // error\n>f : <T>(x: B<T>) => T\n><T>(x: B<T>) => { return x.foo(1); } : <T>(x: B<T>) => T\n>T : any\n>x : B<T>\n>x.foo(1) : T\n>x.foo : (x: T) => T\n>x : B<T>\n>foo : any\n>1 : 1\n\nvar f2 = <T>(x: B<T>) => { return x.foo<T>(1); } // error\n>f2 : <T>(x: B<T>) => T\n><T>(x: B<T>) => { return x.foo<T>(1); } : <T>(x: B<T>) => T\n>T : any\n>x : B<T>\n>x.foo<T>(1) : T\n>x.foo : (x: T) => T\n>x : B<T>\n>foo : any\n>1 : 1\n\nvar f3 = <T>(x: B<T>) => { return x.foo<number>(1); } // error\n>f3 : <T>(x: B<T>) => T\n><T>(x: B<T>) => { return x.foo<number>(1); } : <T>(x: B<T>) => T\n>T : any\n>x : B<T>\n>x.foo<number>(1) : T\n>x.foo : (x: T) => T\n>x : B<T>\n>foo : any\n>1 : 1\n\nvar f4 = (x: B<number>) => { return x.foo(1); } // no error\n>f4 : (x: B<number>) => number\n>(x: B<number>) => { return x.foo(1); } : (x: B<number>) => number\n>x : B<number>\n>x.foo(1) : number\n>x.foo : (x: number) => number\n>x : B<number>\n>foo : any\n>1 : 1\n\n"
generics0,19,"//// [tests/cases/compiler/generics0.ts] ////\n\n=== generics0.ts ===\ninterface G<T> {\n>T : any\n\n    x: T;\n>x : any\n}\n\nvar v2: G<string>;\n>v2 : G<string>\n\nvar z = v2.x; // 'y' should be of type 'string'\n>z : string\n>v2.x : string\n>v2 : G<string>\n>x : any\n\n"
generics1,44,"//// [tests/cases/compiler/generics1.ts] ////\n\n=== generics1.ts ===\ninterface A { a: string; }\n>a : any\n\ninterface B extends A { b: string; }\n>b : any\n\ninterface C extends B { c: string; }\n>c : any\n\ninterface G<T, U extends B> {\n>T : any\n>U : any\n\n    x: T;\n>x : any\n\n    y: U;\n>y : any\n}\nvar v1: G<A, C>;               // Ok\n>v1 : G<A, C>\n\nvar v2: G<{ a: string }, C>;   // Ok, equivalent to G<A, C>\n>v2 : G<{ a: string; }, C>\n>a : any\n\nvar v3: G<A, A>;               // Error, A not valid argument for U\n>v3 : G<A, A>\n\nvar v4: G<G<A, B>, C>;         // Ok\n>v4 : G<G<A, B>, C>\n\nvar v5: G<any, any>;           // Error, any does not satisfy constraint B\n>v5 : G<any, any>\n\nvar v6: G<any>;                // Error, wrong number of arguments\n>v6 : any\n\nvar v7: G;                     // Error, no type arguments\n>v7 : any\n\n"
