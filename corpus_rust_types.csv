varianceCantBeStrictWhileStructureIsnt,72,"//// [tests/cases/compiler/varianceCantBeStrictWhileStructureIsnt.ts] ////\n\n=== varianceCantBeStrictWhileStructureIsnt.ts ===\n// under non-strict-function-types, all the below should work\ninterface Foo<T> {\n>T : any\n\n    member: (cb: T) => void;\n>member : any\n>cb : T\n}\n\ninterface Bar<T> {\n>T : any\n\n    member: (cb: T) => void;\n>member : any\n>cb : T\n}\n\ndeclare var a: Foo<string>;\n>a : Foo<string>\n\ndeclare var b: Foo<"""">;\n>b : Foo<"""">\n\ndeclare var a2: Bar<string>;\n>a2 : Bar<string>\n\ndeclare var b2: Bar<"""">;\n>b2 : Bar<"""">\n\na = b;\n>a = b : Foo<"""">\n>a : Foo<string>\n>b : Foo<"""">\n\nb = a;\n>b = a : Foo<string>\n>b : Foo<"""">\n>a : Foo<string>\n\na2 = b2;\n>a2 = b2 : Bar<"""">\n>a2 : Bar<string>\n>b2 : Bar<"""">\n\nb2 = a2;\n>b2 = a2 : Bar<string>\n>b2 : Bar<"""">\n>a2 : Bar<string>\n\na = b2;\n>a = b2 : Bar<"""">\n>a : Foo<string>\n>b2 : Bar<"""">\n\nb = a2;\n>b = a2 : Bar<string>\n>b : Foo<"""">\n>a2 : Bar<string>\n\na2 = b;\n>a2 = b : Foo<"""">\n>a2 : Bar<string>\n>b : Foo<"""">\n\nb2 = a;\n>b2 = a : Foo<string>\n>b2 : Bar<"""">\n>a : Foo<string>\n\n"
varianceMeasurement,172,"//// [tests/cases/compiler/varianceMeasurement.ts] ////\n\n=== varianceMeasurement.ts ===\n// The type below should be invariant in T but is measured as covariant because\n// we don't analyze recursive references.\n\ninterface Foo1<T> {\n>T : any\n\n  x: T;\n>x : any\n\n  y: Foo1<(arg: T) => void>;\n>y : any\n>arg : T\n}\n\ndeclare const f10: Foo1<string>;\n>f10 : Foo1<string>\n\nconst f11: Foo1<'a'> = f10;\n>f11 : Foo1<""a"">\n>f10 : Foo1<string>\n\nconst f12: Foo1<unknown> = f10;\n>f12 : Foo1<unknown>\n>f10 : Foo1<string>\n\n// The type below is invariant in T and is measured as such.\n\ninterface Foo2<T> {\n>T : any\n\n  x: T;\n>x : any\n\n  y: { x: (arg: T) => void, y: Foo2<(arg: T) => void>; }\n>y : any\n>x : any\n>arg : T\n>y : any\n>arg : T\n}\n\ndeclare const f20: Foo2<string>;\n>f20 : Foo2<string>\n\nconst f21: Foo2<'a'> = f20;\n>f21 : Foo2<""a"">\n>f20 : Foo2<string>\n\nconst f22: Foo2<unknown> = f20;\n>f22 : Foo2<unknown>\n>f20 : Foo2<string>\n\n// The type below should be invariant in T but is measured as covariant because\n// we don't analyze recursive references.\n\ntype Foo3<T> = {\n>Foo3 : Foo3\n>T : any\n\n  x: T;\n>x : any\n\n  y: Foo3<(arg: T) => void>;\n>y : any\n>arg : T\n}\n\ndeclare const f30: Foo3<string>;\n>f30 : Foo3<(arg: string) => void>\n\nconst f31: Foo3<'a'> = f30;\n>f31 : Foo3<(arg: ""a"") => void>\n>f30 : Foo3<(arg: string) => void>\n\nconst f32: Foo3<unknown> = f30;\n>f32 : Foo3<(arg: unknown) => void>\n>f30 : Foo3<(arg: string) => void>\n\n// The type below is invariant in T and is measured as such.\n\ntype Foo4<T> = {\n>Foo4 : Foo4\n>T : any\n\n  x: T;\n>x : any\n\n  y: { x: (arg: T) => void, y: Foo4<(arg: T) => void>; }\n>y : any\n>x : any\n>arg : T\n>y : any\n>arg : T\n}\n\ndeclare const f40: Foo4<string>;\n>f40 : Foo4<(arg: T) => void>\n\nconst f41: Foo4<'a'> = f40;\n>f41 : Foo4<(arg: ""a"") => void>\n>f40 : Foo4<(arg: T) => void>\n\nconst f42: Foo4<unknown> = f40;\n>f42 : Foo4<(arg: unknown) => void>\n>f40 : Foo4<(arg: T) => void>\n\n// Repro from #3580\n\ninterface Fn<A, B> {\n>A : any\n>B : any\n\n  (a: A): B;\n>a : A\n\n  then<C>(next: Fn<B, C>): Fn<A, C>;\n>then : any\n>C : any\n>next : Fn<B, C>\n}\n\ndeclare const fn: Fn<string, number>;\n>fn : Fn<string, number>\n\n// Contravariant in A\nconst fn1: Fn<unknown, number> = fn;  // Error\n>fn1 : Fn<unknown, number>\n>fn : Fn<string, number>\n\nconst fn2: Fn<'a', number> = fn;\n>fn2 : Fn<""a"", number>\n>fn : Fn<string, number>\n\n// Covariant in B\nconst fn3: Fn<string, unknown> = fn;\n>fn3 : Fn<string, unknown>\n>fn : Fn<string, number>\n\nconst fn4: Fn<string, 0> = fn;  // Error\n>fn4 : Fn<string, 0>\n>fn : Fn<string, number>\n\n// Repro from #39947\n\ninterface I<Dummy, V> {\n>Dummy : any\n>V : any\n\n  c: C<Dummy, V>;\n>c : any\n}\n\nclass C<Dummy, V> {\n>C : typeof C\n>Dummy : any\n>V : any\n\n  declare sub: I<Dummy, V>;\n>sub : any\n\n  declare covariance: V;\n>covariance : any\n}\n\nconst c1: C<unknown, string> = new C<unknown, number>();  // Error\n>c1 : C<unknown, string>\n>new C<unknown, number>( : C<unknown, number>\n>C : typeof C\n\n"
