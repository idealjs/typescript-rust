typePredicateInLoop,56,"//// [tests/cases/compiler/typePredicateInLoop.ts] ////\n\n=== typePredicateInLoop.ts ===\n// Repro from #12101\n\ninterface Type {\n  type: number;\n>type : any\n}\n\ninterface TypeExt extends Type {\n  arr: Type[];\n>arr : any\n}\n\nconst guard = (arg: Type): arg is TypeExt => arg.type === 1;\n>guard : (arg: Type) => boolean\n>(arg: Type): arg is TypeExt => arg.type === 1 : (arg: Type) => boolean\n>arg : Type\n>arg : Type\n>arg.type === 1 : boolean\n>arg.type : number\n>arg : Type\n>type : any\n>1 : 1\n\nconst otherFunc = (arg1: Type, arg2: TypeExt): void => {};\n>otherFunc : (arg1: Type, arg2: TypeExt) => void\n>(arg1: Type, arg2: TypeExt): void => {} : (arg1: Type, arg2: TypeExt) => void\n>arg1 : Type\n>arg2 : TypeExt\n\nexport function y(arg: Type): void {\n>y : (arg: Type) => void\n>arg : Type\n\n  if (guard(arg)) {\n>guard(arg) : boolean\n>guard : (arg: Type) => boolean\n>arg : Type\n\n    for (const ITEM of arg.arr) {\n>ITEM : any\n>arg.arr : any\n>arg : Type\n>arr : any\n\n      if (otherFunc(ITEM, arg)) {\n>otherFunc(ITEM, arg) : void\n>otherFunc : (arg1: Type, arg2: TypeExt) => void\n>ITEM : any\n>arg : TypeExt\n      }\n    }\n  }\n}\n"
typePredicateInherit,101,"//// [tests/cases/compiler/typePredicateInherit.ts] ////\n\n=== typePredicateInherit.ts ===\ninterface A {\n  method1(): this is {\n>method1 : any\n\n    a: 1\n>a : any\n  }\n  method2(): boolean;\n>method2 : any\n\n  method3(): this is {\n>method3 : any\n\n    a: 1\n>a : any\n\n  };\n}\nclass B implements A {\n>B : typeof B\n\n  method1() { }      // should error\n>method1 : any\n\n  method2() { }   // should error\n>method2 : any\n\n  method3() {   // should error\n>method3 : any\n\n    return true\n>true : true\n  }\n}\n\nclass C {\n>C : typeof C\n\n  method1(): this is {\n>method1 : any\n\n    a: 1\n>a : any\n\n  } {\n    return true;\n>true : true\n  }\n\n  method2(): this is {\n>method2 : any\n\n    a: 1\n>a : any\n\n  } {\n    return true;\n>true : true\n  }\n\n  method3(): this is {\n>method3 : any\n\n    a: 1\n>a : any\n\n  } {\n    return true;\n>true : true\n  }\n}\n\nclass D extends C {\n>D : typeof D\n>C : C\n\n  method1(): void {   // should error\n>method1 : any\n  }\n\n  method2(): this is {  // should ok\n>method2 : any\n\n    a: 1\n>a : any\n\n  } {\n    return true;\n>true : true\n  }\n\n  method3(): boolean {  // should error\n>method3 : any\n\n    return true;\n>true : true\n  }\n}\n"
typePredicateParameterMismatch,50,"//// [tests/cases/compiler/typePredicateParameterMismatch.ts] ////\n\n=== typePredicateParameterMismatch.ts ===\n// This test verifies that the checker doesn't panic when a type predicate\n// references a parameter name that doesn't match any actual function parameter.\n\ntype TypeA = { kind: 'a' };\n>TypeA : TypeA\n>kind : any\n\ntype TypeB = { kind: 'b' };\n>TypeB : TypeB\n>kind : any\n\ntype UnionType = TypeA | TypeB;\n>UnionType : UnionType\n\nfunction isTypeA(\n>isTypeA : (_value: UnionType) => boolean\n\n  _value: UnionType\n>_value : UnionType\n\n): value is TypeA {  // ""value"" doesn't match parameter ""_value""\n>value : any\n\n  return true;\n>true : true\n}\n\nfunction test(input: UnionType): void {\n>test : (input: UnionType) => void\n>input : UnionType\n\n  if (isTypeA(input)) {\n>isTypeA(input) : boolean\n>isTypeA : (_value: UnionType) => boolean\n>input : UnionType\n\n    console.log(input.kind);\n>console.log(input.kind) : void\n>console.log : (...data: any[]) => void\n>console : Console\n>log : any\n>input.kind : ""a"" | ""b""\n>input : UnionType\n>kind : any\n  }\n}\n\n"
typePredicateStructuralMatch,99,"//// [tests/cases/compiler/typePredicateStructuralMatch.ts] ////\n\n=== typePredicateStructuralMatch.ts ===\n// Repro from #12235\n\ngetResults1([]);\n>getResults1([]) : Result[]\n>getResults1 : (value: Result[] | { data: Result[]; }) => Result[]\n>[] : never[]\n\ngetResults1({data: []});\n>getResults1({data: []}) : Result[]\n>getResults1 : (value: Result[] | { data: Result[]; }) => Result[]\n>{data: []} : { data: never[]; }\n>data : any\n>[] : never[]\n\ngetResults2([]);\n>getResults2([]) : Result[]\n>getResults2 : (value: Result[] | { data: Result[]; }) => Result[]\n>[] : never[]\n\ngetResults2({data: []});\n>getResults2({data: []}) : Result[]\n>getResults2 : (value: Result[] | { data: Result[]; }) => Result[]\n>{data: []} : { data: never[]; }\n>data : any\n>[] : never[]\n\ntype Result = { value: string };\n>Result : Result\n>value : any\n\ntype Results = Result[];\n>Results : Results\n\nfunction isResponseInData<T>(value: T | { data: T}): value is { data: T } {\n>isResponseInData : <T>(value: T | { data: T; }) => boolean\n>T : any\n>value : T | { data: T; }\n>data : any\n>value : T | { data: T; }\n>data : any\n\n    return value.hasOwnProperty('data');\n>value.hasOwnProperty('data') : boolean\n>value.hasOwnProperty : (v: PropertyKey) => boolean\n>value : T | { data: T; }\n>hasOwnProperty : any\n>'data' : ""data""\n}\n\nfunction getResults1(value: Results | { data: Results }): Results {\n>getResults1 : (value: Result[] | { data: Result[]; }) => Result[]\n>value : Result[] | { data: Result[]; }\n>data : any\n\n    return isResponseInData(value) ? value.data : value;\n>isResponseInData(value) ? value.data : value : Result[]\n>isResponseInData(value) : boolean\n>isResponseInData : <T>(value: T | { data: T; }) => boolean\n>value : Result[] | { data: Result[]; }\n>value.data : Result[]\n>value : { data: Result[]; }\n>data : any\n>value : Result[]\n}\n\nfunction isPlainResponse<T>(value: T | { data: T}): value is T {\n>isPlainResponse : 