baseExpressionTypeParameters,35,"//// [tests/cases/compiler/baseExpressionTypeParameters.ts] ////\n\n=== baseExpressionTypeParameters.ts ===\n// Repro from #17829\n\nfunction base<T>() {\n>base : <T>() => typeof Base\n>T : any\n\n    class Base {\n>Base : typeof Base\n\n        static prop: T;\n>prop : any\n    }\n    return Base;\n>Base : typeof Base\n}\n\nclass Gen<T> extends base<T>() {}  // Error, T not in scope\n>Gen : typeof Gen\n>T : any\n>base<T>() : base<unresolved>\n>base : <T>() => typeof Base\n\nclass Spec extends Gen<string> {}\n>Spec : typeof Spec\n>Gen : Gen<string>\n\n<string>Spec.prop;\n><string>Spec.prop : string\n>Spec.prop : unresolved\n>Spec : typeof Spec\n>prop : any\n\n"
