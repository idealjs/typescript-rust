indexTypeCheck,146,"//// [tests/cases/compiler/indexTypeCheck.ts] ////\n\n=== indexTypeCheck.ts ===\ninterface Red {\n	[n:number]; // ok\n>n : any\n\n	[s:string]; // ok\n>s : string\n}\n\ninterface Blue {\n	[n:number]: any; // ok\n>n : any\n\n	[s:string]: any; // ok\n>s : string\n}\n\ninterface Yellow {\n	[n:number]: Red; // ok\n>n : any\n\n	[s:string]: Red; // ok\n>s : string\n}\n\ninterface Orange {\n	[n:number]: number; // ok\n>n : any\n\n	[s:string]: string; // error\n>s : string\n}\n\ninterface Green {\n	[n:number]: Orange; // error\n>n : any\n\n	[s:string]: Yellow; // ok\n>s : string\n}\n\ninterface Cyan {\n	[n:number]: number; // error\n>n : any\n\n	[s:string]: string; // ok\n>s : string\n}\n\ninterface Purple {\n	[n:number, s:string]; // error\n>n : any\n>s : string\n}\n\ninterface Magenta {\n	[p:Purple]; // error\n>p : any\n}\n\ndeclare var yellow: Yellow;\n>yellow : Yellow\n\ndeclare var blue: Blue;\n>blue : Blue\n\nvar s = ""some string"";\n>s : string\n>""some string"" : ""some string""\n\nyellow[5]; // ok\n>yellow[5] : Red\n>yellow : Yellow\n>5 : 5\n\nyellow[""hue""]; // ok\n>yellow[""hue""] : Red\n>yellow : Yellow\n>""hue"" : ""hue""\n\nyellow[<any>{}]; // ok\n>yellow[<any>{}] : Red\n>yellow : Yellow\n><any>{} : any\n>{} : {}\n\ns[0]; // error\n>s[0] : string\n>s : string\n>0 : 0\n\ns[""s""]; // ok\n>s[""s""] : string\n>s : string\n>""s"" : ""s""\n\ns[<any>{}]; // ok\n>s[<any>{}] : string\n>s : string\n><any>{} : any\n>{} : {}\n\nyellow[blue]; // error\n>yellow[blue] : Red\n>yellow : Yellow\n>blue : Blue\n\ndeclare var x:number[];\n>x : number[]\n\nx[0];\n>x[0] : number\n>x : number[]\n>0 : 0\n\nclass Benchmark {\n>Benchmark : typeof Benchmark\n\n    public results: { [x:string]: any; } = <{ [x:string]: any; }>{};\n>results : any\n>x : number[]\n><{ [x:string]: any; }>{} : { [x: string]: any; }\n>x : number[]\n>{} : {}\n\n    public addTimingFor(name: string, timing: number) {\n>addTimingFor : any\n>name : string\n>timing : number\n\n        this.resul