indexSignatureAndMappedType,88,"//// [tests/cases/compiler/indexSignatureAndMappedType.ts] ////\n\n=== indexSignatureAndMappedType.ts ===\n// A mapped type { [P in K]: X }, where K is a generic type, is related to\n// { [key: string]: Y } if X is related to Y.\n\nfunction f1<T, K extends string>(x: { [key: string]: T }, y: Record<K, T>) {\n>f1 : <T, K extends string>(x: { [key: string]: T; }, y: Record<K, T>) => void\n>T : any\n>K : any\n>x : { [key: string]: T; }\n>key : any\n>y : Record<K, T>\n\n    x = y;\n>x = y : Record<K, T>\n>x : { [key: string]: T; }\n>y : Record<K, T>\n\n    y = x;  // Error\n>y = x : { [key: string]: T; }\n>y : Record<K, T>\n>x : { [key: string]: T; }\n}\n\nfunction f2<T>(x: { [key: string]: T }, y: Record<string, T>) {\n>f2 : <T>(x: { [key: string]: T; }, y: Record<string, T>) => void\n>T : any\n>x : { [key: string]: T; }\n>key : any\n>y : Record<string, T>\n\n    x = y;\n>x = y : Record<string, T>\n>x : { [key: string]: T; }\n>y : Record<string, T>\n\n    y = x;\n>y = x : { [key: string]: T; }\n>y : Record<string, T>\n>x : { [key: string]: T; }\n}\n\nfunction f3<T, U, K extends string>(x: { [key: string]: T }, y: Record<K, U>) {\n>f3 : <T, U, K extends string>(x: { [key: string]: T; }, y: Record<K, U>) => void\n>T : any\n>U : any\n>K : any\n>x : { [key: string]: T; }\n>key : any\n>y : Record<K, U>\n\n    x = y;  // Error\n>x = y : Record<K, U>\n>x : { [key: string]: T; }\n>y : Record<K, U>\n\n    y = x;  // Error\n>y = x : { [key: string]: T; }\n>y : Record<K, U>\n>x : { [key: string]: T; }\n}\n\n// Repro from #14548\n\ntype Dictionary = {\n>Dictionary : Dictionary\n\n    [key: string]: string;\n>key : any\n\n};\n\ninterface IBaseEntity {\n    name: string;\n>name : void\n\n    properties: Dictionary;\n>properties : any\n}\n\ninterface IEntity<T extends string> extends IBaseEntity {\n>T : any\n\n    properties: Record<T, string>;\n>properties : any\n}\n\n"
