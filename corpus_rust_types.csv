genericUnboundedTypeParamAssignability,66,"//// [tests/cases/compiler/genericUnboundedTypeParamAssignability.ts] ////\n\n=== genericUnboundedTypeParamAssignability.ts ===\nfunction f1<T>(o: T) {\n>f1 : <T>(o: T) => void\n>T : any\n>o : T\n\n  o.toString(); // error\n>o.toString() : any\n>o.toString : any\n>o : T\n>toString : () => string\n}\n\nfunction f2<T extends {}>(o: T) {\n>f2 : <T extends {}>(o: T) => void\n>T : any\n>o : T\n\n  o.toString(); // no error\n>o.toString() : string\n>o.toString : () => string\n>o : T\n>toString : () => string\n}\n\nfunction f3<T extends Record<string, any>>(o: T) {\n>f3 : <T extends Record<string, any>>(o: T) => void\n>T : any\n>o : T\n\n  o.toString(); // no error\n>o.toString() : any\n>o.toString : any\n>o : T\n>toString : () => string\n}\n\nfunction user<T>(t: T) {\n>user : <T>(t: T) => void\n>T : any\n>t : T\n\n  f1(t);\n>f1(t) : void\n>f1 : <T>(o: T) => void\n>t : T\n\n  f2(t); // error in strict, unbounded T doesn't satisfy the constraint\n>f2(t) : void\n>f2 : <T extends {}>(o: T) => void\n>t : T\n\n  f3(t); // error in strict, unbounded T doesn't satisfy the constraint\n>f3(t) : void\n>f3 : <T extends Record<string, any>>(o: T) => void\n>t : T\n\n  t.toString();  // error, for the same reason as f1()\n>t.toString() : any\n>t.toString : any\n>t : T\n>toString : () => string\n}\n\n"
