genericFunctions3,24,"//// [tests/cases/compiler/genericFunctions3.ts] ////\n\n=== genericFunctions3.ts ===\ninterface Query<T> {\n>T : any\n\n    foo(x: string): Query<T[]>;\n>foo : any\n>x : string\n}\n \nfunction from<T>(arg: boolean): Query<T>; // was Error: Overload signature is not compatible with function definition.\n>from : <T>(arg: boolean) => Query<T>\n>T : any\n>arg : boolean\n\nfunction from<T>(arg: any): Query<T> {\n>from : <T>(arg: boolean) => Query<T>\n>T : any\n>arg : any\n\n    return undefined;\n}\n\n"
genericFunctionsAndConditionalInference,159,"//// [tests/cases/compiler/genericFunctionsAndConditionalInference.ts] ////\n\n=== genericFunctionsAndConditionalInference.ts ===\ntype Boxified<T> = { [P in keyof T]: { value: T[P]} };\n>Boxified : Boxified\n>T : any\n>P : any\n>value : any\n\ndeclare function unboxify<T>(obj: Boxified<T>): T;\n>unboxify : <T>(obj: Boxified<T>) => T\n>T : any\n>obj : Boxified<T>\n\nfunction foo<U, V>(obj: { u: { value: U }, v: { value: V } }) {\n>foo : <U, V>(obj: { u: { value: U; }; v: { value: V; }; }) => { u: U; v: V; }\n>U : any\n>V : any\n>obj : { u: { value: U; }; v: { value: V; }; }\n>u : any\n>value : any\n>v : any\n>value : any\n\n    return unboxify(obj);\n>unboxify(obj) : { u: U; v: V; }\n>unboxify : <T>(obj: Boxified<T>) => T\n>obj : { u: { value: U; }; v: { value: V; }; }\n}\n\nlet qq = foo({ u: { value: 10 }, v: { value: 'hello'} });  // { u: U, v: V } but should be { u: number, v: string }\n>qq : { u: U; v: V; }\n>foo({ u: { value: 10 }, v: { value: 'hello'} }) : { u: U; v: V; }\n>foo : <U, V>(obj: { u: { value: U; }; v: { value: V; }; }) => { u: U; v: V; }\n>{ u: { value: 10 }, v: { value: 'hello'} } : { u: { value: number; }; v: { value: string; }; }\n>u : any\n>{ value: 10 } : { value: number; }\n>value : any\n>10 : 10\n>v : any\n>{ value: 'hello'} : { value: string; }\n>value : any\n>'hello' : ""hello""\n\n// From #42385\ninterface Targets<A> {\n>A : any\n\n    left: A\n>left : Ops<""left"">\n\n    right: A\n>right : Ops<""right"">\n}\ntype Target = keyof Targets<any>\n>Target : Target\n\ntype Result<F extends Target, A> = Targets<A>[F]\n>Result : Result\n>F : any\n>A : any\n\ntype LR<F extends Target, L, R> = [F] extends [""left""] ? L : R\n>LR : LR\n>F : any\n>L : any\n>R : any\n\ninterface Ops<F extends Target> {\n>F : any\n\n    _f: F\n>_f : any\n\n    str: Result<F, string>\n>str : any\n\n    num: Result<F, number>\n>num : any\n\n    lr<I, O>(a: Result<F, I>, o: Result<F, O>): Result<F, LR<F, I, O>>\n>lr : any\n>I : any\n>O : any\n>a : Targets<I>[F]\n>o : Targets<O>[F]\n\n    dict: <P>(p: {[k in keyof P]: Result<F, P[k]>}) => Result<F, P>\n>dict : any\n>P : any\n>p : { [k in keyof P]: any; }\n>k : any\n}\nconst left: Ops<""left""> = {} as any\n>left : Ops<""left"">\n>{} as any : any\n>{} : {}\n\nconst right: Ops<""right""> = {} as any\n>right : Ops<""right"">\n>{} as any : any\n>{} : {}\n\nconst ok = <F extends Target>(at: Ops<F>) => ({lr: at.lr(at.str, at.num)})\n>ok : <F extends ""left"" | ""right"">(at: Ops<F>) => { lr: Targets<LR<F, I, O>>[F]; }\n><F extends Target>(at: Ops<F>) => ({lr: at.lr(at.str, at.num)}) : <F extends ""left"" | ""right"">(at: Ops<F>) => { lr: Targets<LR<F, I, O>>[F]; }\n>F : any\n>at : Ops<F>\n>({lr: at.lr(at.str, at.num)}) : { lr: Targets<LR<F, I, O>>[F]; }\n>{lr: at.lr(at.str, at.num)} : { lr: Targets<LR<F, I, O>>[F]; }\n>lr : any\n>at.lr(at.str, at.num) : Targets<LR<F, I, O>>[F]\n>at.lr : <I, O>(a: Targets<I>[F], o: Targets<O>[F]) => Targets<LR<F, I, O>>[F]\n>at : Ops<F>\n>lr : any\n>at.str : Targets<string>[F]\n>at : Ops<F>\n>str : any\n>at.num : Targets<number>[F]\n>at : Ops<F>\n>num : any\n\nconst orphaned = <F extends Target>(at: Ops<F>) => at.dict(ok(at))\n>orphaned : <F extends ""left"" | ""right"">(at: Ops<F>) => Targets<{ lr: LR<F, I, O>; }>[F]\n><F extends Target>(at: Ops<F>) => at.dict(ok(at)) : <F extends ""left"" | ""right"">(at: Ops<F>) => Targets<{ lr: LR<F, I, O>; }>[F]\n>F : any\n>at : Ops<F>\n>at.dict(ok(at)) : Targets<{ lr: LR<F, I, O>; }>[F]\n>at.dict : <P>(p: { [k in keyof P]: Targets<P[k]>[F]; }) => Targets<P>[F]\n>at : Ops<F>\n>dict : any\n>ok(at) : { lr: Targets<LR<F, I, O>>[F]; }\n>ok : <F extends ""left"" | ""right"">(at: Ops<F>) => { lr: Targets<LR<F, I, O>>[F]; }\n>at : Ops<F>\n\nconst leftOk = ok(left)\n>leftOk : { lr: LR<F, I, O>; }\n>ok(left) : { lr: LR<F, I, O>; }\n>ok : <F extends ""left"" | ""right"">(at: Ops<F>) => { lr: Targets<LR<F, I, O>>[F]; }\n>left : Ops<""left"">\n\nconst leftOrphaned = orphaned(left)\n>leftOrphaned : P\n>orphaned(left) : P\n>orphaned : <F extends ""left"" | ""right"">(at: Ops<F>) => Targets<{ lr: LR<F, I, O>; }>[F]\n>left : Ops<""left"">\n\nconst rightOk = ok(right)\n>rightOk : { lr: LR<F, I, O>; }\n>ok(right) : { lr: LR<F, I, O>; }\n>ok : <F extends ""left"" | ""right"">(at: Ops<F>) => { lr: Targets<LR<F, I, O>>[F]; }\n>right : Ops<""right"">\n\nconst rightOrphaned = orphaned(right)\n>rightOrphaned : P\n>orphaned(right) : P\n>orphaned : <F extends ""left"" | ""right"">(at: Ops<F>) => Targets<{ lr: LR<F, I, O>; }>[F]\n>right : Ops<""right"">\n\n"
