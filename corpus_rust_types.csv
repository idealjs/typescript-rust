superAccess(target=es2015),47,"//// [tests/cases/compiler/superAccess.ts] ////\n\n=== superAccess.ts ===\nclass MyBase {\n>MyBase : typeof MyBase\n\n    static S1: number = 5;\n>S1 : any\n>5 : 5\n\n    private S2: string = ""test"";\n>S2 : any\n>""test"" : ""test""\n\n    f = () => 5;\n>f : any\n>() => 5 : () => number\n>5 : 5\n}\n\nclass MyDerived extends MyBase {\n>MyDerived : typeof MyDerived\n>MyBase : MyBase\n\n    foo() {\n>foo : any\n\n        var l3 = super.S1;    // Expected => Error: Only public instance methods of the base class are accessible via the 'super' keyword\n>l3 : any\n>super.S1 : any\n>super : MyBase\n>S1 : any\n\n        var l4 = super.S2;    // Expected => Error: Only public instance methods of the base class are accessible via the 'super' keyword\n>l4 : string\n>super.S2 : string\n>super : MyBase\n>S2 : any\n\n        var l5 = super.f();   // Expected => Error: Only public instance methods of the base class are accessible via the 'super' keyword\n>l5 : number\n>super.f() : number\n>super.f : () => number\n>super : MyBase\n>f : any\n    }\n}\n"
superAccess2,90,"//// [tests/cases/compiler/superAccess2.ts] ////\n\n=== superAccess2.ts ===\nclass P {\n>P : typeof P\n\n    x() { }\n>x : any\n\n    static y() { }\n>y : any\n}\n\nclass Q extends P {\n>Q : typeof Q\n>P : P\n\n    xx = super;\n>xx : any\n> super : any\n>super : P\n> : any\n\n    static yy = super; // error for static initializer accessing super\n>yy : any\n> super : any\n>super : typeof P\n> : any\n\n    // Super is not allowed in constructor args\n    constructor(public z = super, zz = super, zzz = () => super) {\n>z : any\n> super : any\n>super : P\n> : any\n>zz : any\n> super : any\n>super : P\n> : any\n>zzz : any\n>() => super : () => any\n> super : any\n>super : P\n> : any\n\n        super();\n>super() : void\n>super : P\n    }\n\n    foo(zz = super) {\n>foo : any\n>zz : any\n> super : any\n>super : P\n> : any\n\n        super.x();\n>super.x() : void\n>super.x : () => void\n>super : P\n>x : any\n\n        super.y(); // error\n>super.y() : any\n>super.y : any\n>super : P\n>y : any\n    }\n\n    static bar(zz = super) {\n>bar : any\n>zz : any\n> super : any\n>super : typeof P\n> : any\n\n        super.x(); // error\n>super.x() : any\n>super.x : any\n>super : typeof P\n>x : any\n\n        super.y();\n>super.y() : void\n>super.y : () => void\n>super : typeof P\n>y : any\n    }\n}\n"
