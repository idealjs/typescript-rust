overEagerReturnTypeSpecialization,65,"//// [tests/cases/compiler/overEagerReturnTypeSpecialization.ts] ////\n\n=== overEagerReturnTypeSpecialization.ts ===\n//Note: Below simpler repro\n\ninterface I1<T> {\n>T : any\n\n    func<U>(callback: (value: T) => U): I1<U>;\n>func : any\n>U : any\n>callback : (value: T) => U\n>value : T\n}\n \ndeclare var v1: I1<number>;\n>v1 : I1<number>\n\nvar r1: I1<string> = v1.func(num => num.toString()) // Correctly returns an I1<string>\n>r1 : I1<string>\n>v1.func(num => num.toString()) // Correctly returns an I1<string>           .func(str => str.length) : I1<string>\n>v1.func(num => num.toString()) // Correctly returns an I1<string>           .func : <U>(callback: (value: string) => U) => I1<U>\n>v1.func(num => num.toString()) : I1<string>\n>v1.func : <U>(callback: (value: number) => U) => I1<U>\n>v1 : I1<number>\n>func : any\n>num => num.toString() : (num: number) => string\n>num : number\n>num.toString() : string\n>num.toString : (radix?: number | undefined) => string\n>num : number\n>toString : () => string\n\n           .func(str => str.length);    // should error\n>func : any\n>str => str.length : (str: string) => number\n>str : string\n>str.length : number\n>str : string\n>length : number\n\nvar r2: I1<number> = v1.func(num => num.toString()) // Correctly returns an I1<string>\n>r2 : I1<number>\n>v1.func(num => num.toString()) // Correctly returns an I1<string>           .func(str => str.length) : I1<number>\n>v1.func(num => num.toString()) // Correctly returns an I1<string>           .func : <U>(callback: (value: string) => U) => I1<U>\n>v1.func(num => num.toString()) : I1<string>\n>v1.func : <U>(callback: (value: number) => U) => I1<U>\n>v1 : I1<number>\n>func : any\n>num => num.toString() : (num: number) => string\n>num : number\n>num.toString() : string\n>num.toString : (radix?: number | undefined) => string\n>num : number\n>toString : () => string\n\n           .func(str => str.length);    // should be ok \n>func : any\n>str => str.length : (str: string) => number\n>str : string\n>str.length : number\n>str : string\n>length : number\n \n \n"
overload1,163,"//// [tests/cases/compiler/overload1.ts] ////\n\n=== overload1.ts ===\nnamespace O {\n>O : typeof O\n\n    export class A {\n>A : typeof O.A\n        \n    }\n\n    export class B extends A {\n>B : typeof O.B\n>A : O.A\n    }\n\n    export class C extends B {\n>C : typeof O.C\n>B : O.B\n        \n    }\n\n    export interface I {\n        f(s:string):number;\n>f : any\n>s : string\n\n        f(n:number):string;\n>f : any\n>n : number\n\n        g(n1:number,n2:number):number;\n>g : any\n>n1 : number\n>n2 : number\n\n        g(n:number):string;\n>g : any\n>n : number\n\n        g(a:A):C;\n>g : any\n>a : O.A\n\n        g(c:C):string;\n>g : any\n>c : O.C\n\n        h(s1:string,s2:number):string;\n>h : any\n>s1 : string\n>s2 : number\n\n        h(s1:number,s2:string):number;\n>h : any\n>s1 : number\n>s2 : string\n    }\n}\n\ndeclare var x:O.I;\n>x : O.I\n>O : typeof O\n\nvar e:string=x.g(new O.A()); // matches overload but bad assignment\n>e : string\n>x.g(new O.A()) : O.C\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n>new O.A( : O.A\n>O.A : typeof O.A\n>O : typeof O\n>A : any\n\nvar y:string=x.f(3); // good\n>y : string\n>x.f(3) : string\n>x.f : { (s: string): number; (n: number): string; }\n>x : O.I\n>f : any\n>3 : 3\n\ny=x.f(""nope""); // can't assign number to string\n>y=x.f(""nope"") : number\n>y : string\n>x.f(""nope"") : number\n>x.f : { (s: string): number; (n: number): string; }\n>x : O.I\n>f : any\n>""nope"" : ""nope""\n\nvar z:string=x.g(x.g(3,3)); // good\n>z : string\n>x.g(x.g(3,3)) : string\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n>x.g(3,3) : number\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n>3 : 3\n>3 : 3\n\nz=x.g(2,2,2); // no match\n>z=x.g(2,2,2) : never\n>z : string\n>x.g(2,2,2) : never\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n>2 : 2\n>2 : 2\n>2 : 2\n\nz=x.g(); // no match\n>z=x.g() : never\n>z : string\n>x.g() : never\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n\nz=x.g(new O.B()); // ambiguous (up and down conversion)\n>z=x.g(new O.B()) : O.C\n>z : string\n>x.g(new O.B()) : O.C\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n>new O.B( : O.B\n>O.B : typeof O.B\n>O : typeof O\n>B : any\n\nz=x.h(2,2); // no match\n>z=x.h(2,2) : never\n>z : string\n>x.h(2,2) : never\n>x.h : { (s1: string, s2: number): string; (s1: number, s2: string): number; }\n>x : O.I\n>h : any\n>2 : 2\n>2 : 2\n\nz=x.h(""hello"",0); // good\n>z=x.h(""hello"",0) : string\n>z : string\n>x.h(""hello"",0) : string\n>x.h : { (s1: string, s2: number): string; (s1: number, s2: string): number; }\n>x : O.I\n>h : any\n>""hello"" : ""hello""\n>0 : 0\n\nvar v=x.g;\n>v : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x.g : { (n1: number, n2: number): number; (n: number): string; (a: O.A): O.C; (c: O.C): string; }\n>x : O.I\n>g : any\n\n\n"
overload2,40,"//// [tests/cases/compiler/overload2.ts] ////\n\n=== overload2.ts ===\nenum A { }\n>A : typeof A\n\nenum B { }\n>B : typeof B\n    \nfunction foo(a: A);\n>foo : { (a: ): any; (b: ): any; }\n>a : \n\nfunction foo(b: B);\n>foo : { (a: ): any; (b: ): any; }\n>b : \n\n// should be ok\nfunction foo(x: number) { \n>foo : { (a: ): any; (b: ): any; }\n>x : number\n}\n\nclass C { }\n>C : typeof C\n\nfunction foo1(a: A);\n>foo1 : { (a: ): any; (c: C): any; }\n>a : \n\nfunction foo1(c: C);\n>foo1 : { (a: ): any; (c: C): any; }\n>c : C\n\n// should be ok\nfunction foo1(x: number) { \n>foo1 : { (a: ): any; (c: C): any; }\n>x : number\n}\n\n"
overloadAssignmentCompat,88,"//// [tests/cases/compiler/overloadAssignmentCompat.ts] ////\n\n=== overloadAssignmentCompat.ts ===\n// ok - overload signatures are assignment compatible with their implementation\nclass Accessor {}\n>Accessor : typeof Accessor\n\nfunction attr(name: string): string;\n>attr : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>name : string\n\nfunction attr(name: string, value: string): Accessor;\n>attr : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>name : string\n>value : string\n\nfunction attr(map: any): Accessor;\n>attr : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>map : any\n\nfunction attr(nameOrMap: any, value?: string): any {\n>attr : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>nameOrMap : any\n>value : string | undefined\n\n    if (nameOrMap && typeof nameOrMap === ""object"") {\n>nameOrMap && typeof nameOrMap === ""object"" : any\n>nameOrMap : any\n>typeof nameOrMap === ""object"" : boolean\n>typeof nameOrMap : ""bigint"" | ""boolean"" | ""function"" | ""number"" | ""object"" | ""string"" | ""symbol"" | ""undefined""\n>nameOrMap : any\n>""object"" : ""object""\n\n        // handle map case\n        return new Accessor;\n>new Accessor : Accessor\n>Accessor : typeof Accessor\n    }\n    else {\n        // handle string case\n        return ""s"";\n    }\n}\n\n// not ok - there's an assignment compat error\nfunction attr2(name: string): string;\n>attr2 : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>name : string\n\nfunction attr2(name: string, value: string): Accessor;\n>attr2 : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>name : string\n>value : string\n\nfunction attr2(map: any): Accessor;\n>attr2 : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>map : any\n\nfunction attr2(nameOrMap: any, value?: string): string {\n>attr2 : { (name: string): string; (name: string, value: string): Accessor; (map: any): Accessor; }\n>nameOrMap : any\n>value : string | undefined\n\n    if (nameOrMap && typeof nameOrMap === ""object"") {\n>nameOrMap && typeof nameOrMap === ""object"" : any\n>nameOrMap : any\n>typeof nameOrMap === ""object"" : boolean\n>typeof nameOrMap : ""bigint"" | ""boolean"" | ""function"" | ""number"" | ""object"" | ""string"" | ""symbol"" | ""undefined""\n>nameOrMap : any\n>""object"" : ""object""\n\n        // handle map case\n        return ""t"";\n    }\n    else {\n        // handle string case\n        return ""s"";\n    }\n}\n\n// error - signatures are not assignment compatible\nfunction foo():number; \n>foo : () => number\n\nfunction foo():string { return ""a"" };\n>foo : () => number\n\n\n"
overloadBindingAcrossDeclarationBoundaries,86,"//// [tests/cases/compiler/overloadBindingAcrossDeclarationBoundaries.ts] ////\n\n=== overloadBindingAcrossDeclarationBoundaries.ts ===\ninterface Opt1 {\n    p?: any;\n>p : any\n}\ninterface Opt2 {\n    q?: any;\n>q : any\n}\ninterface Opt3 {\n    r?: any;\n>r : any\n}\ninterface Opt4 {\n    s?: any;\n>s : any\n}\ninterface A {\n    a(o: Opt1): Opt1;\n>a : A\n>o : Opt1\n\n    a(o: Opt2): Opt2;\n>a : A\n>o : Opt2\n\n    (o: Opt1): Opt1;\n>o : Opt1\n\n    (o: Opt2): Opt2;\n>o : Opt2\n\n    new (o: Opt1): Opt1;\n>o : Opt1\n\n    new (o: Opt2): Opt2;\n>o : Opt2\n}\ninterface A {\n    a(o: Opt3): Opt3;\n>a : A\n>o : Opt3\n\n    a(o: Opt4): Opt4;\n>a : A\n>o : Opt4\n\n    (o: Opt3): Opt3;\n>o : Opt3\n\n    (o: Opt4): Opt4;\n>o : Opt4\n\n    new (o: Opt3): Opt3;\n>o : Opt3\n\n    new (o: Opt4): Opt4;\n>o : Opt4\n}\n\nvar a: A;\n>a : A\n\n// These should all be Opt3\nvar a1 = a.a({});\n>a1 : Opt3\n>a.a({}) : Opt3\n>a.a : { (o: Opt1): Opt1; (o: Opt2): Opt2; (o: Opt3): Opt3; (o: Opt4): Opt4; }\n>a : A\n>a : A\n>{} : {}\n\nvar a1 = a({});\n>a1 : Opt3\n>a({}) : Opt3\n>a : A\n>{} : {}\n\nvar a1 = new a({});\n>a1 : Opt3\n>new a({} : Opt1\n>a : A\n>{} : {}\n\n"
overloadBindingAcrossDeclarationBoundaries2,90,"//// [tests/cases/compiler/overloadBindingAcrossDeclarationBoundaries2.ts] ////\n\n=== overloadBindingAcrossDeclarationBoundaries_file0.ts ===\ninterface Opt1 {\n    p?: any;\n>p : any\n}\ninterface Opt2 {\n    q?: any;\n>q : any\n}\ninterface Opt3 {\n    r?: any;\n>r : any\n}\ninterface Opt4 {\n    s?: any;\n>s : any\n}\n\ninterface A {\n    a(o: Opt1): Opt1;\n>a : A\n>o : Opt1\n\n    a(o: Opt2): Opt2;\n>a : A\n>o : Opt2\n\n    (o: Opt1): Opt1;\n>o : Opt1\n\n    (o: Opt2): Opt2;\n>o : Opt2\n\n    new (o: Opt1): Opt1;\n>o : Opt1\n\n    new (o: Opt2): Opt2;\n>o : Opt2\n}\n\n\n=== overloadBindingAcrossDeclarationBoundaries_file1.ts ===\ninterface A {\n    a(o: Opt3): Opt3;\n>a : A\n>o : Opt3\n\n    a(o: Opt4): Opt4;\n>a : A\n>o : Opt4\n\n    (o: Opt3): Opt3;\n>o : Opt3\n\n    (o: Opt4): Opt4;\n>o : Opt4\n\n    new (o: Opt3): Opt3;\n>o : Opt3\n\n    new (o: Opt4): Opt4;\n>o : Opt4\n}\n\nvar a: A;\n>a : A\n\n// These should all be Opt3\nvar a1 = a.a({});\n>a1 : Opt3\n>a.a({}) : Opt3\n>a.a : { (o: Opt1): Opt1; (o: Opt2): Opt2; (o: Opt3): Opt3; (o: Opt4): Opt4; }\n>a : A\n>a : A\n>{} : {}\n\nvar a1 = a({});\n>a1 : Opt3\n>a({}) : Opt3\n>a : A\n>{} : {}\n\nvar a1 = new a({});\n>a1 : Opt3\n>new a({} : Opt1\n>a : A\n>{} : {}\n\n"
overloadCallTest,40,"//// [tests/cases/compiler/overloadCallTest.ts] ////\n\n=== overloadCallTest.ts ===\nclass foo {\n>foo : typeof foo\n\n    constructor() {\n        function bar(): string;\n>bar : { (): string; (s: string): any; }\n\n        function bar(s:string);\n>bar : { (): string; (s: string): any; }\n>s : string\n\n        function bar(foo?: string) { return ""foo"" };\n>bar : { (): string; (s: string): any; }\n>foo : string\n\n        var test = bar(""test"");\n>test : any\n>bar(""test"") : any\n>bar : { (): string; (s: string): any; }\n>""test"" : ""test""\n\n        var goo = bar();\n>goo : string\n>bar() : string\n>bar : { (): string; (s: string): any; }\n\n        goo = bar(""test"");\n>goo = bar(""test"") : any\n>goo : string\n>bar(""test"") : any\n>bar : { (): string; (s: string): any; }\n>""test"" : ""test""\n    }\n \n}\n\n\n"
overloadConsecutiveness,33,"//// [tests/cases/compiler/overloadConsecutiveness.ts] ////\n\n=== overloadConsecutiveness.ts ===\n// Making sure compiler won't break with declarations that are consecutive in the AST but not consecutive in the source. Syntax errors intentional.\n\nfunction f1(), function f1();\n>f1 : () => any\n>f1 : () => any\n\nfunction f2(), function f2() {}\n>f2 : () => void\n>f2 : () => void\n\nfunction f3() {}, function f3();\n>f3 : () => any\n>f3 : () => any\n\nclass C {\n>C : typeof C\n\n	m1(), m1();\n>m1 : any\n>m1 : any\n\n	m2(), m2() {}\n>m2 : any\n>m2 : any\n\n	m3() {}, m3();\n>m3 : any\n>m3 : any\n}\n\n"
overloadCrash,35,"//// [tests/cases/compiler/overloadCrash.ts] ////\n\n=== overloadCrash.ts ===\ninterface I1 {a:number; b:number;};\n>a : any\n>b : any\n\ninterface I2 {c:number; d:number;};\n>c : any\n>d : any\n\ninterface I3 {a:number; b:number; c:number; d:number;};\n>a : any\n>b : any\n>c : any\n>d : any\n\ndeclare function foo(...n:I1[]);\n>foo : { (...n: I1[]): any; (n1: I2, n3: I2): any; }\n>n : I1[]\n\ndeclare function foo(n1:I2, n3:I2);\n>foo : { (...n: I1[]): any; (n1: I2, n3: I2): any; }\n>n1 : I2\n>n3 : I2\n\nvar i3:I3;\n>i3 : I3\n\nfoo(i3, i3); // should not crash the compiler :)\n>foo(i3, i3) : any\n>foo : { (...n: I1[]): any; (n1: I2, n3: I2): any; }\n>i3 : I3\n>i3 : I3\n\n"
overloadEquivalenceWithStatics,26,"//// [tests/cases/compiler/overloadEquivalenceWithStatics.ts] ////\n\n=== overloadEquivalenceWithStatics.ts ===\nclass A1<T> {\n>A1 : typeof A1\n>T : any\n\nstatic B<S>(v: A1<S>): A1<S>; // 1 \n>B : any\n>S : any\n>v : A1<S>\n\nstatic B<S>(v: S): A1<S>; // 2 : Error Duplicate signature\n>B : any\n>S : any\n>v : S\n\nstatic B<S>(v: any): A1<S> {\n>B : any\n>S : any\n>v : any\n\nreturn null;\n}\n}\n\n"
