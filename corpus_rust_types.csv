indirectTypeParameterReferences,100,"//// [tests/cases/compiler/indirectTypeParameterReferences.ts] ////\n\n=== indirectTypeParameterReferences.ts ===\n// Repro from #19043\n\ntype B = {b: string}\n>B : B\n>b : any\n\nconst flowtypes = <A>(b: B) => {\n>flowtypes : <A>(b: B) => { combined: (fn: (combined: Combined) => void) => any; literal: (fn: (aPlusB: Combined) => void) => any; }\n><A>(b: B) => {  type Combined = A & B  const combined = (fn: (combined: Combined) => void) => null  const literal = (fn: (aPlusB: A & B) => void) => null  return {combined, literal}} : <A>(b: B) => { combined: (fn: (combined: Combined) => void) => any; literal: (fn: (aPlusB: Combined) => void) => any; }\n>A : any\n>b : B\n\n  type Combined = A & B\n>Combined : Combined\n\n  const combined = (fn: (combined: Combined) => void) => null\n>combined : (fn: (combined: Combined) => void) => any\n>(fn: (combined: Combined) => void) => null : (fn: (combined: Combined) => void) => any\n>fn : (combined: Combined) => void\n>combined : Combined\n\n  const literal = (fn: (aPlusB: A & B) => void) => null\n>literal : (fn: (aPlusB: Combined) => void) => any\n>(fn: (aPlusB: A & B) => void) => null : (fn: (aPlusB: Combined) => void) => any\n>fn : (aPlusB: Combined) => void\n>aPlusB : Combined\n\n  return {combined, literal}\n>{combined, literal} : { combined: (fn: (combined: Combined) => void) => any; literal: (fn: (aPlusB: Combined) => void) => any; }\n>combined : (fn: (combined: Combined) => void) => any\n>literal : (fn: (aPlusB: Combined) => void) => any\n}\n\nconst {combined, literal} = flowtypes<{a: string}>({b: 'b-value'})\n>{combined, literal} : any\n>combined : (fn: (combined: Combined) => void) => any\n>literal : (fn: (aPlusB: Combined) => void) => any\n>flowtypes<{a: string}>({b: 'b-value'}) : { combined: (fn: (combined: Combined) => void) => any; literal: (fn: (aPlusB: Combined) => void) => any; }\n>flowtypes : <A>(b: B) => { combined: (fn: (combined: Combined) => void) => any; literal: (fn: (aPlusB: Combined) => void) => any; }\n>a : any\n>{b: 'b-value'} : { b: string; }\n>b : any\n>'b-value' : ""b-value""\n\nliteral(aPlusB => {\n>literal(aPlusB => {  aPlusB.b  aPlusB.a}) : any\n>literal : (fn: (aPlusB: Combined) => void) => any\n>aPlusB => {  aPlusB.b  aPlusB.a} : (aPlusB: Combined) => void\n>aPlusB : Combined\n\n  aPlusB.b\n>aPlusB.b : string\n>aPlusB : Combined\n>b : any\n\n  aPlusB.a\n>aPlusB.a : string\n>aPlusB : Combined\n>a : any\n\n})\n\ncombined(comb => {\n>combined(comb => {  comb.b  comb.a}) : any\n>combined : (fn: (combined: Combined) => void) => any\n>comb => {  comb.b  comb.a} : (comb: Combined) => void\n>comb : Combined\n\n  comb.b\n>comb.b : string\n>comb : Combined\n>b : any\n\n  comb.a\n>comb.a : string\n>comb : Combined\n>a : any\n\n})\n\n// Repro from #19091\n\ndeclare function f<T>(a: T): { a: typeof a };\n>f : <T>(a: T) => { a: T; }\n>T : any\n>a : T\n>a : T\n>a : T\n\nlet n: number = f(2).a;\n>n : number\n>f(2).a : number\n>f(2) : { a: number; }\n>f : <T>(a: T) => { a: T; }\n>2 : 2\n>a : any\n\n"
