typeAssignabilityErrorMessage,91,"//// [tests/cases/compiler/typeAssignabilityErrorMessage.ts] ////\n\n=== typeAssignabilityErrorMessage.ts ===\n// Example: different error code altogether\n\ninterface ThroughStream {\n    a: string;\n>a : Bar<number>\n}\ninterface ReadStream {\n    f: string;\n>f : any\n\n    g: number;\n>g : any\n\n    h: boolean;\n>h : any\n\n    i: BigInt;\n>i : any\n\n    j: symbol;\n>j : any\n}\nfunction foo(): ReadStream {\n>foo : () => ReadStream\n\n    return undefined as any as ThroughStream;\n>undefined as any as ThroughStream : ThroughStream\n>undefined as any : any\n}\nfunction bar(): ReadStream {\n>bar : () => ReadStream\n\n    return undefined as any as ThroughStream;\n>undefined as any as ThroughStream : ThroughStream\n>undefined as any : any\n}\n\n// Example: different elaboration\n\ntype Wrap = {\n>Wrap : Wrap\n\n    someProp: Bar<number>;\n>someProp : any\n}\ntype OtherWrap = {\n>OtherWrap : OtherWrap\n\n    someProp: Foo<string>;\n>someProp : any\n}\ntype Foo<T> = {\n>Foo : Foo\n>T : any\n\n    foo: { what: T };\n>foo : () => ReadStream\n>what : any\n}\ntype Bar<T> = {\n>Bar : Bar\n>T : any\n\n    foo: { what: T };\n>foo : () => ReadStream\n>what : any\n\n} | boolean;\n\nfunction fun(param: Wrap): void {}\n>fun : (param: Wrap) => void\n>param : Wrap\n\ndeclare let fooStr: Foo<string>;\n>fooStr : Foo<string>\n\ndeclare let otherWrap: OtherWrap;\n>otherWrap : OtherWrap\n\nlet a: Bar<number> = fooStr;\n>a : Bar<number>\n>fooStr : Foo<string>\n\nfun(otherWrap);\n>fun(otherWrap) : void\n>fun : (param: Wrap) => void\n>otherWrap : OtherWrap\n\n"
