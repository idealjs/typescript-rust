promiseChaining,57,"//// [tests/cases/compiler/promiseChaining.ts] ////\n\n=== promiseChaining.ts ===\nclass Chain<T> {\n>Chain : typeof Chain\n>T : any\n\n    constructor(public value: T) { }\n>value : T\n\n    then<S>(cb: (x: T) => S): Chain<S> {\n>then : any\n>S : any\n>cb : (x: T) => S\n>x : T\n\n        var result = cb(this.value);\n>result : S\n>cb(this.value) : S\n>cb : (x: T) => S\n>this.value : T\n>this : this\n>value : any\n\n        // should get a fresh type parameter which each then call\n        var z = this.then(x => result)/*S*/.then(x => ""abc"")/*string*/.then(x => x.length)/*number*/; // No error\n>z : Chain<number>\n>this.then(x => result)/*S*/.then(x => ""abc"")/*string*/.then(x => x.length) : Chain<number>\n>this.then(x => result)/*S*/.then(x => ""abc"")/*string*/.then : <S>(cb: (x: string) => S) => Chain<S>\n>this.then(x => result)/*S*/.then(x => ""abc"") : Chain<string>\n>this.then(x => result)/*S*/.then : <S>(cb: (x: unknown) => S) => Chain<S>\n>this.then(x => result) : Chain<unknown>\n>this.then : <S>(cb: (x: T) => S) => Chain<S>\n>this : this\n>then : any\n>x => result : (x: T) => S\n>x : T\n>result : S\n>then : any\n>x => ""abc"" : (x: unknown) => string\n>x : unknown\n>""abc"" : ""abc""\n>then : any\n>x => x.length : (x: string) => number\n>x : string\n>x.length : number\n>x : string\n>length : number\n\n        return new Chain(result);\n>new Chain(result : Chain<S>\n>Chain : typeof Chain\n>result : S\n    }\n}\n\n\n"
promiseChaining1,57,"//// [tests/cases/compiler/promiseChaining1.ts] ////\n\n=== promiseChaining1.ts ===\n// same example but with constraints on each type parameter\nclass Chain2<T extends { length: number }> {\n>Chain2 : typeof Chain2\n>T : any\n>length : number\n\n    constructor(public value: T) { }\n>value : T\n\n    then<S extends Function>(cb: (x: T) => S): Chain2<S> {\n>then : any\n>S : any\n>cb : (x: T) => S\n>x : T\n\n        var result = cb(this.value);\n>result : S\n>cb(this.value) : S\n>cb : (x: T) => S\n>this.value : T\n>this : this\n>value : any\n\n        // should get a fresh type parameter which each then call\n        var z = this.then(x => result)/*S*/.then(x => ""abc"")/*Function*/.then(x => x.length)/*number*/; // Should error on ""abc"" because it is not a Function\n>z : Chain2<Function>\n>this.then(x => result)/*S*/.then(x => ""abc"")/*Function*/.then(x => x.length) : Chain2<Function>\n>this.then(x => result)/*S*/.then(x => ""abc"")/*Function*/.then : <S extends Function>(cb: (x: Function) => S) => Chain2<S>\n>this.then(x => result)/*S*/.then(x => ""abc"") : Chain2<Function>\n>this.then(x => result)/*S*/.then : <S extends Function>(cb: (x: Function) => S) => Chain2<S>\n>this.then(x => result) : Chain2<Function>\n>this.then : <S extends Function>(cb: (x: T) => S) => Chain2<S>\n>this : this\n>then : any\n>x => result : (x: T) => S\n>x : T\n>result : S\n>then : any\n>x => ""abc"" : (x: Function) => string\n>x : Function\n>""abc"" : ""abc""\n>then : any\n>x => x.length : (x: Function) => number\n>x : Function\n>x.length : number\n>x : Function\n>length : number\n\n        return new Chain2(result);\n>new Chain2(result : Chain2<S>\n>Chain2 : typeof Chain2\n>result : S\n    }\n}\n"
