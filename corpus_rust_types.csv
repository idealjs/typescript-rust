typeParametersShouldNotBeEqual,34,"//// [tests/cases/compiler/typeParametersShouldNotBeEqual.ts] ////\n\n=== typeParametersShouldNotBeEqual.ts ===\nfunction ff<T, U>(x: T, y: U) {\n>ff : <T, U>(x: T, y: U) => void\n>T : any\n>U : any\n>x : T\n>y : U\n\n    var z!: Object;\n>z : Object\n\n    x = x;  // Ok\n>x = x : T\n>x : T\n>x : T\n\n    x = y;  // Error\n>x = y : U\n>x : T\n>y : U\n\n    x = z;  // Error\n>x = z : Object\n>x : T\n>z : Object\n\n    z = x;  // Ok\n>z = x : T\n>z : Object\n>x : T\n}\n\n"
typeParametersShouldNotBeEqual2,56,"//// [tests/cases/compiler/typeParametersShouldNotBeEqual2.ts] ////\n\n=== typeParametersShouldNotBeEqual2.ts ===\nfunction ff<T extends Date, U extends Date, V>(x: T, y: U, z: V) {\n>ff : <T extends Date, U extends Date, V>(x: T, y: U, z: V) => void\n>T : any\n>U : any\n>V : any\n>x : T\n>y : U\n>z : V\n\n    var zz!: Object;\n>zz : Object\n\n    x = x;  // Ok\n>x = x : T\n>x : T\n>x : T\n\n    x = y;  // Ok\n>x = y : U\n>x : T\n>y : U\n\n    x = z;  // Error\n>x = z : V\n>x : T\n>z : V\n\n    z = x;  // Error\n>z = x : T\n>z : V\n>x : T\n\n    y = z;  // Error\n>y = z : V\n>y : U\n>z : V\n\n    z = y;  // Error\n>z = y : U\n>z : V\n>y : U\n\n    x = zz;  // Error\n>x = zz : Object\n>x : T\n>zz : Object\n\n    zz = x;  // Ok\n>zz = x : T\n>zz : Object\n>x : T\n}\n\n"
typeParametersShouldNotBeEqual3,34,"//// [tests/cases/compiler/typeParametersShouldNotBeEqual3.ts] ////\n\n=== typeParametersShouldNotBeEqual3.ts ===\nfunction ff<T extends Object, U extends Object>(x: T, y: U) {\n>ff : <T extends Object, U extends Object>(x: T, y: U) => void\n>T : any\n>U : any\n>x : T\n>y : U\n\n    var z!: Object;\n>z : Object\n\n    x = x;  // Ok\n>x = x : T\n>x : T\n>x : T\n\n    x = y;  // Ok\n>x = y : U\n>x : T\n>y : U\n\n    x = z;  // Ok\n>x = z : Object\n>x : T\n>z : Object\n\n    z = x;  // Ok\n>z = x : T\n>z : Object\n>x : T\n}\n\n"
typePartameterConstraintInstantiatedWithDefaultWhenCheckingDefault,62,"//// [tests/cases/compiler/typePartameterConstraintInstantiatedWithDefaultWhenCheckingDefault.ts] ////\n\n=== typePartameterConstraintInstantiatedWithDefaultWhenCheckingDefault.ts ===\n// tricky interface\ninterface Settable<T, V> {\n>T : any\n>V : any\n\n    set(value: V): T;\n>set : any\n>value : V\n}\n\n// implement\nclass Identity<V> implements Settable<Identity<V>, V> {\n>Identity : typeof Identity\n>V : any\n\n    readonly item: V;\n>item : any\n\n    constructor(value: V) {\n>value : V\n\n        this.item = value;\n>this.item = value : V\n>this.item : V\n>this : this\n>item : any\n>value : V\n    }\n    public set(value: V): Identity<V> {\n>set : any\n>value : V\n\n        return new Identity<V>(value);\n>new Identity<V>(value : Identity<V>\n>Identity : typeof Identity\n>value : V\n    }\n}\n\n// generic parameter default\ninterface Test1<V, T extends Settable<T, V> = Identity<V>> { };\n>V : any\n>T : any\n\nlet test1: Test1<number>;\n>test1 : Test1<number, Identity<V>>\n\n// not generic parameter default\ninterface Test2Base<V, T extends Settable<T, V>> { };\n>V : any\n>T : any\n\ntype Test2<V> = Test2Base<V, Identity<V>>;\n>Test2 : Test2\n>V : any\n\nlet test2: Test2<number>;\n>test2 : Test2Base<number, Identity<number>>\n\n"
typePredicateAcceptingPartialOfRefinedType,20,"//// [tests/cases/compiler/typePredicateAcceptingPartialOfRefinedType.ts] ////\n\n=== typePredicateAcceptingPartialOfRefinedType.ts ===\n// repro #51953\n\ninterface Test {\n  testy?: string;\n>testy : any\n}\n\ninterface Options {\n  test: Test['testy'];\n>test : any\n}\n\ndeclare function includesAllRequiredOptions(options: Partial<Options>): options is Options;\n>includesAllRequiredOptions : (options: Partial<Options>) => boolean\n>options : Partial<Options>\n>options : Partial<Options>\n\n"
typePredicateFreshLiteralWidening,108,"//// [tests/cases/compiler/typePredicateFreshLiteralWidening.ts] ////\n\n=== typePredicateFreshLiteralWidening.ts ===\ntype Narrowable = string | number | bigint | boolean;\n>Narrowable : Narrowable\n\ntype Narrow<A> = (A extends Narrowable ? A : never) | ({\n>Narrow : Narrow\n>A : any\n\n    [K in keyof A]: Narrow<A[K]>;\n>K : any\n\n});\n\nconst satisfies =\n>satisfies : <TWide>() => <TNarrow extends TWide>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n\n  <TWide,>() =>\n><TWide,>() =>  <TNarrow extends TWide>(narrow: Narrow<TNarrow>) =>    narrow : <TWide>() => <TNarrow extends TWide>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>TWide : any\n\n  <TNarrow extends TWide>(narrow: Narrow<TNarrow>) =>\n><TNarrow extends TWide>(narrow: Narrow<TNarrow>) =>    narrow : <TNarrow extends TWide>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>TNarrow : any\n>narrow : Narrow<TNarrow>\n\n    narrow;\n>narrow : Narrow<TNarrow>\n\n/* ========================================================================== */\n\nconst isNotNull = <T,>(value: T | null): value is T => value !== null;\n>isNotNull : <T>(value: T | null) => boolean\n><T,>(value: T | null): value is T => value !== null : <T>(value: T | null) => boolean\n>T : any\n>value : T | null\n>value : T | null\n>value !== null : boolean\n>value : T | null\n\ntype Item = { value: string | null };\n>Item : Item\n>value : any\n\nconst item1 = satisfies<Item>()({ value: ""1"" });\n>item1 : Narrow<{ value: string; }>\n>satisfies<Item>()({ value: ""1"" }) : Narrow<{ value: string; }>\n>satisfies<Item>() : <TNarrow extends Item>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>satisfies : <TWide>() => <TNarrow extends TWide>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>{ value: ""1"" } : { value: string; }\n>value : any\n>""1"" : ""1""\n\nconst item2 = satisfies<Item>()({ value: ""2"" });\n>item2 : Narrow<{ value: string; }>\n>satisfies<Item>()({ value: ""2"" }) : Narrow<{ value: string; }>\n>satisfies<Item>() : <TNarrow extends Item>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>satisfies : <TWide>() => <TNarrow extends TWide>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>{ value: ""2"" } : { value: string; }\n>value : any\n>""2"" : ""2""\n\nconst item3 = satisfies<Item>()({ value: null });\n>item3 : Narrow<{ value: any; }>\n>satisfies<Item>()({ value: null }) : Narrow<{ value: any; }>\n>satisfies<Item>() : <TNarrow extends Item>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>satisfies : <TWide>() => <TNarrow extends TWide>(narrow: Narrow<TNarrow>) => Narrow<TNarrow>\n>{ value: null } : { value: null; }\n>value : any\n\nconst values2: Array<""1"" | ""2"" | null> = [""1"", ""2"", null];\n>values2 : (""1"" | ""2"" | null)[]\n>[""1"", ""2"", null] : (""1"" | ""2"" | null)[]\n>""1"" : ""1""\n>""2"" : ""2""\n\nconst filteredValues2 = values2.filter(isNotNull);\n>filteredValues2 : (""1"" | ""2"")[]\n>values2.filter(isNotNull) : (""1"" | ""2"")[]\n>values2.filter : { <S extends ""1"" | ""2"" | null>(predicate: (value: ""1"" | ""2"" | null, index: number, array: (""1"" | ""2"" | null)[]) => boolean, thisArg?: any): S[]; (predicate: (value: ""1"" | ""2"" | null, index: number, array: (""1"" | ""2"" | null)[]) => unknown, thisArg?: any): (""1"" | ""2"" | null)[]; }\n>values2 : (""1"" | ""2"" | null)[]\n>filter : any\n>isNotNull : <T>(value: T | null) => boolean\n\nconst values1 = [item1, item2, item3].map(item => item.value);\n>values1 : any[]\n>[item1, item2, item3].map(item => item.value) : any[]\n>[item1, item2, item3].map : <U>(callbackfn: (value: Narrow<{ value: any; }>, index: number, array: Narrow<{ value: any; }>[]) => U, thisArg?: any) => U[]\n>[item1, item2, item3] : Narrow<{ value: any; }>[]\n>item1 : Narrow<{ value: string; }>\n>item2 : Narrow<{ value: string; }>\n>item3 : Narrow<{ value: any; }>\n>map : any\n>item => item.value : (item: Narrow<{ value: any; }>) => any\n>item : Narrow<{ value: any; }>\n>item.value : any\n>item : Narrow<{ value: any; }>\n>val