typeParameterDiamond1,42,"//// [tests/cases/compiler/typeParameterDiamond1.ts] ////\n\n=== typeParameterDiamond1.ts ===\nfunction diamondTop<Top>() {\n>diamondTop : <Top>() => void\n>Top : any\n\n    function diamondMiddle<T extends Top, U extends Top>() {\n>diamondMiddle : <T extends Top, U extends Top>() => void\n>T : any\n>U : any\n\n        function diamondBottom<Bottom extends T | U>() {\n>diamondBottom : <Bottom extends T | U>() => void\n>Bottom : any\n\n            var top: Top;\n>top : Top\n\n            var middle: T | U;\n>middle : T | U\n\n            var bottom: Bottom;\n>bottom : Bottom\n\n            top = middle;\n>top = middle : T | U\n>top : Top\n>middle : T | U\n\n            middle = bottom;\n>middle = bottom : Bottom\n>middle : T | U\n>bottom : Bottom\n\n            top = bottom;\n>top = bottom : Bottom\n>top : Top\n>bottom : Bottom\n        }\n    }\n}\n"
typeParameterDiamond2,42,"//// [tests/cases/compiler/typeParameterDiamond2.ts] ////\n\n=== typeParameterDiamond2.ts ===\nfunction diamondTop<Top>() {\n>diamondTop : <Top>() => void\n>Top : any\n\n    function diamondMiddle<T extends Top, U>() {\n>diamondMiddle : <T extends Top, U>() => void\n>T : any\n>U : any\n\n        function diamondBottom<Bottom extends T | U>() {\n>diamondBottom : <Bottom extends T | U>() => void\n>Bottom : any\n\n            var top!: Top;\n>top : Top\n\n            var middle!: T | U;\n>middle : T | U\n\n            var bottom!: Bottom;\n>bottom : Bottom\n\n            top = middle;\n>top = middle : T | U\n>top : Top\n>middle : T | U\n\n            middle = bottom;\n>middle = bottom : Bottom\n>middle : T | U\n>bottom : Bottom\n\n            top = bottom;\n>top = bottom : Bottom\n>top : Top\n>bottom : Bottom\n        }\n    }\n}\n"
typeParameterDiamond3,42,"//// [tests/cases/compiler/typeParameterDiamond3.ts] ////\n\n=== typeParameterDiamond3.ts ===\nfunction diamondTop<Top>() {\n>diamondTop : <Top>() => void\n>Top : any\n\n    function diamondMiddle<T, U>() {\n>diamondMiddle : <T, U>() => void\n>T : any\n>U : any\n\n        function diamondBottom<Bottom extends Top | T | U>() {\n>diamondBottom : <Bottom extends T | Top | U>() => void\n>Bottom : any\n\n            var top!: Top;\n>top : Top\n\n            var middle!: T | U;\n>middle : T | U\n\n            var bottom!: Bottom;\n>bottom : Bottom\n\n            top = middle;\n>top = middle : T | U\n>top : Top\n>middle : T | U\n\n            middle = bottom;\n>middle = bottom : Bottom\n>middle : T | U\n>bottom : Bottom\n\n            top = bottom;\n>top = bottom : Bottom\n>top : Top\n>bottom : Bottom\n        }\n    }\n}\n"
