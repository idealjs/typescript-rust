genericConstructorFunction1,61,"//// [tests/cases/compiler/genericConstructorFunction1.ts] ////\n\n=== genericConstructorFunction1.ts ===\nfunction f1<T>(args: T) {\n>f1 : <T>(args: T) => Date\n>T : any\n>args : T\n\n    var v1!: { [index: string]: new (arg: T) => Date };\n>v1 : { [index: string]: new (arg: T) => Date; }\n>index : any\n>arg : T\n\n    var v2 = v1['test'];\n>v2 : new (arg: T) => Date\n>v1['test'] : new (arg: T) => Date\n>v1 : { [index: string]: new (arg: T) => Date; }\n>'test' : ""test""\n\n    v2(args); \n>v2(args) : any\n>v2 : new (arg: T) => Date\n>args : T\n\n    return new v2(args); // used to give error\n>new v2(args : Date\n>v2 : new (arg: T) => Date\n>args : T\n}\n\n\ninterface I1<T> { new (arg: T): Date };\n>T : any\n>arg : T\n\nfunction f2<T>(args: T) {\n>f2 : <T>(args: T) => Date\n>T : any\n>args : T\n\n    var v1!: { [index: string]: I1<T> };\n>v1 : { [index: string]: I1<T>; }\n>index : any\n\n    var v2 = v1['test'];\n>v2 : I1<T>\n>v1['test'] : I1<T>\n>v1 : { [index: string]: I1<T>; }\n>'test' : ""test""\n\n    var y = v2(args); \n>y : any\n>v2(args) : any\n>v2 : I1<T>\n>args : T\n\n    return new v2(args); // used to give error\n>new v2(args : Date\n>v2 : I1<T>\n>args : T\n}\n"
