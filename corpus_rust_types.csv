lambdaParameterWithTupleArgsHasCorrectAssignability,69,"//// [tests/cases/compiler/lambdaParameterWithTupleArgsHasCorrectAssignability.ts] ////\n\n=== lambdaParameterWithTupleArgsHasCorrectAssignability.ts ===\ntype MyTupleItem = {};\n>MyTupleItem : MyTupleItem\n\ntype MyTuple = [MyTupleItem, ...MyTupleItem[]];\n>MyTuple : MyTuple\n\ntype GenericFunction<T extends MyTuple> = (...fromArgs: T) => void;\n>GenericFunction : GenericFunction\n>T : any\n>fromArgs : T\n\nclass GenericClass<T extends MyTuple> {\n>GenericClass : typeof GenericClass\n>T : any\n\n    from: GenericFunction<T> | undefined;\n>from : any\n}\n\nfunction createClass<T extends MyTuple>(f: GenericFunction<T>): GenericClass<T> {\n>createClass : <T extends [MyTupleItem, ...MyTupleItem]>(f: GenericFunction<T>) => GenericClass<T>\n>T : any\n>f : GenericFunction<T>\n\n    return new GenericClass<T>(/* ... use f */);\n>new GenericClass<T>( : GenericClass<T>\n>GenericClass : typeof GenericClass\n}\n\nfunction consumeClass(c: GenericClass<[string, boolean]>) { }\n>consumeClass : (c: GenericClass<[string, boolean]>) => void\n>c : GenericClass<[string, boolean]>\n\n// should work\nconsumeClass(createClass(str => console.log(str.length)));\n>consumeClass(createClass(str => console.log(str.length))) : void\n>consumeClass : (c: GenericClass<[string, boolean]>) => void\n>createClass(str => console.log(str.length)) : GenericClass<[MyTupleItem, ...MyTupleItem]>\n>createClass : <T extends [MyTupleItem, ...MyTupleItem]>(f: GenericFunction<T>) => GenericClass<T>\n>str => console.log(str.length) : (str: MyTupleItem) => void\n>str : MyTupleItem\n>console.log(str.length) : void\n>console.log : (...data: any[]) => void\n>console : Console\n>log : any\n>str.length : any\n>str : MyTupleItem\n>length : number\n\n// should work\nconsumeClass(createClass((str, _unused_num) => console.log(str.length)));\n>consumeClass(createClass((str, _unused_num) => console.log(str.length))) : void\n>consumeClass : (c: GenericClass<[string, boolean]>) => void\n>createClass((str, _unused_num) => console.log(str.length)) : GenericClass<[MyTupleItem, ...MyTupleItem]>\n>createClass : <T extends [MyTupleItem, ...MyTupleItem]>(f: GenericFunction<T>) => GenericClass<T>\n>(str, _unused_num) => console.log(str.length) : (str: MyTupleItem, _unused_num: MyTupleItem) => void\n>str : MyTupleItem\n>_unused_num : MyTupleItem\n>console.log(str.length) : void\n>console.log : (...data: any[]) => void\n>console : Console\n>log : any\n>str.length : any\n>str : MyTupleItem\n>length : number\n\n"
