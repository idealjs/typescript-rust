number, string>([o], [o]);\n>t4 : { c: number; d: string; }\n>x.g<number, string>([o], [o]) : { c: number; d: string; }\n>x.g : <T, U>(...arg: { a: T; b: U; }[][]) => { c: T; d: U; }\n>x : I\n>g : any\n>[o] : { a: number; b: string; }[]\n>o : { a: number; b: string; }\n>[o] : { a: number; b: string; }[]\n>o : { a: number; b: string; }\n\nvar t4: { c: number; d: string };\n>t4 : { c: number; d: string; }\n>c : any\n>d : any\n\n"
typeArgInference2,64,"//// [tests/cases/compiler/typeArgInference2.ts] ////\n\n=== typeArgInference2.ts ===\ninterface Item {\n    name: string;\n>name : void\n}\n\ndeclare function foo<T extends Item>(x?: T, y?: T): T;\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n>T : any\n>x : T | undefined\n>y : T | undefined\n\nvar z1 = foo(null);                   // any\n>z1 : Item\n>foo(null) : Item\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n\nvar z2 = foo();                       // Item\n>z2 : Item\n>foo() : Item\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n\nvar z3 = foo({ name: null });         // { name: any }\n>z3 : { name: any; }\n>foo({ name: null }) : { name: any; }\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n>{ name: null } : { name: null; }\n>name : void\n\nvar z4 = foo({ name: ""abc"" });        // { name: string }\n>z4 : { name: string; }\n>foo({ name: ""abc"" }) : { name: string; }\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n>{ name: ""abc"" } : { name: string; }\n>name : void\n>""abc"" : ""abc""\n\nvar z5 = foo({ name: ""abc"", a: 5 });  // { name: string; a: number }\n>z5 : { name: string; a: number; }\n>foo({ name: ""abc"", a: 5 }) : { name: string; a: number; }\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n>{ name: ""abc"", a: 5 } : { name: string; a: number; }\n>name : void\n>""abc"" : ""abc""\n>a : any\n>5 : 5\n\nvar z6 = foo({ name: ""abc"", a: 5 }, { name: ""def"", b: 5 });  // error\n>z6 : { name: string; a: number; } | { name: string; b: number; }\n>foo({ name: ""abc"", a: 5 }, { name: ""def"", b: 5 }) : { name: string; a: number; } | { name: string; b: number; }\n>foo : <T extends Item>(x?: T | undefined, y?: T | undefined) => T\n>{ name: ""abc"", a: 5 } : { name: string; a: number; }\n>name : void\n>""abc"" : ""abc""\n>a : any\n>5 : 5\n>{ name: ""def"", b: 5 } : { name: string; b: number; }\n>name : void\n