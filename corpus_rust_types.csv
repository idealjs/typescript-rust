duplicateSymbolsExportMatching,110,"//// [tests/cases/compiler/duplicateSymbolsExportMatching.ts] ////\n\n=== duplicateSymbolsExportMatching.ts ===\nnamespace M {\n>M : typeof M\n\n    export interface E { }\n    interface I { }\n}\nnamespace M {\n>M : typeof M\n\n    export interface E { } // ok\n    interface I { } // ok\n}\n\n// Doesn't match export visibility, but it's in a different parent, so it's ok\nnamespace M {\n>M : typeof M\n\n    interface E { } // ok\n    export interface I { } // ok\n}\n\nnamespace N {\n>N : any\n\n    interface I { }\n    interface I { } // ok\n    export interface E { }\n    export interface E { } // ok\n}\n\nnamespace N2 {\n>N2 : any\n\n    interface I { }\n    export interface I { } // error\n    export interface E { }\n    interface E { } // error\n}\n\n// Should report error only once for instantiated module\nnamespace M {\n>M : typeof M\n\n    namespace inst {\n>inst : typeof inst\n\n        var t;\n>t : any\n    }\n    export namespace inst { // one error\n>inst : typeof inst\n\n        var t;\n>t : any\n    }\n}\n\n// Variables of the same / different type\nnamespace M2 {\n>M2 : typeof M2\n\n    var v: string;\n>v : string\n\n    export var v: string; // one error (visibility)\n>v : string\n\n    var w: number;\n>w : number\n\n    export var w: string; // two errors (visibility and type mismatch)\n>w : number\n}\n\nnamespace M {\n>M : typeof M\n\n    namespace F {\n>F : typeof F\n\n        var t;\n>t : any\n    }\n    export function F() { } // Only one error for duplicate identifier (don't consider visibility)\n>F : typeof F\n}\n\nnamespace M {\n>M : typeof M\n\n    class C { }\n>C : M.C\n\n    namespace C { }\n>C : M.C\n\n    export namespace C { // Two visibility errors (one for the clodule symbol, and one for the merged container symbol)\n>C : M.C\n\n        var t;\n>t : any\n    }\n}\n\n// Top level\ninterface D { }\nexport interface D { }\n"
