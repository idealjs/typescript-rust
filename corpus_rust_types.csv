typeParameterExplicitlyExtendsAny,94,"//// [tests/cases/compiler/typeParameterExplicitlyExtendsAny.ts] ////\n\n=== typeParameterExplicitlyExtendsAny.ts ===\nfunction fee<T>() {\n>fee : <T>() => void\n>T : any\n\n    var t!: T;\n>t : T\n\n    t.blah; // Error\n>t.blah : any\n>t : T\n>blah : any\n\n    t.toString; // ok\n>t.toString : () => string\n>t : T\n>toString : () => string\n}\n\nfunction fee2<T extends any>() {\n>fee2 : <T extends unknown>() => void\n>T : any\n\n    var t!: T;\n>t : T\n\n    t.blah; // ok\n>t.blah : any\n>t : T\n>blah : any\n\n    t.toString; // ok\n>t.toString : () => string\n>t : T\n>toString : () => string\n}\n\nfunction f<T extends any>(x: T) {\n>f : <T extends unknown>(x: T) => void\n>T : any\n>x : T\n\n    x.children;\n>x.children : any\n>x : T\n>children : any\n\n    x();\n>x() : any\n>x : T\n\n    new x();\n>new x( : any\n>x : T\n\n    x[100];\n>x[100] : any\n>x : T\n>100 : 100\n\n    x['hello'];\n>x['hello'] : any\n>x : T\n>'hello' : ""hello""\n}\n\n\n// Generic Tree structure\ntype Tree<T> = T & {\n>Tree : Tree\n>T : any\n\n    children?: Tree<T>[];\n>children : any\n}\n\nclass MyClass {\n>MyClass : typeof MyClass\n\n    public static displayTree1<T extends Tree<any>>(tree: T) {\n>displayTree1 : any\n>T : any\n>tree : T\n\n        // error ""Property 'children' does not exist on type 'T'""\n        tree.children;\n>tree.children : any\n>tree : T\n>children : any\n    }\n}\n\n"
typeParameterExtendingUnion1,44,"//// [tests/cases/compiler/typeParameterExtendingUnion1.ts] ////\n\n=== typeParameterExtendingUnion1.ts ===\nclass Animal { run() { } }\n>Animal : typeof Animal\n>run : (a: Animal) => void\n\nclass Cat extends Animal { meow }\n>Cat : typeof Cat\n>Animal : Animal\n>meow : any\n\nclass Dog extends Animal { woof }\n>Dog : typeof Dog\n>Animal : Animal\n>woof : any\n\nfunction run(a: Animal) {\n>run : (a: Animal) => void\n>a : Animal\n\n    a.run();\n>a.run() : void\n>a.run : () => void\n>a : Animal\n>run : (a: Animal) => void\n}\n\nfunction f<T extends Cat | Dog>(a: T) {\n>f : <T extends Cat | Dog>(a: T) => void\n>T : any\n>a : T\n\n    a.run();\n>a.run() : void\n>a.run : () => void\n>a : Cat | Dog\n>run : (a: Animal) => void\n\n    run(a);\n>run(a) : void\n>run : (a: Animal) => void\n>a : Cat | Dog\n}\n"
typeParameterExtendingUnion2,44,"//// [tests/cases/compiler/typeParameterExtendingUnion2.ts] ////\n\n=== typeParameterExtendingUnion2.ts ===\nclass Animal { run() { } }\n>Animal : typeof Animal\n>run : (a: Cat | Dog) => void\n\nclass Cat extends Animal { meow }\n>Cat : typeof Cat\n>Animal : Animal\n>meow : any\n\nclass Dog extends Animal { woof }\n>Dog : typeof Dog\n>Animal : Animal\n>woof : any\n\nfunction run(a: Cat | Dog) {\n>run : (a: Cat | Dog) => void\n>a : Cat | Dog\n\n    a.run();\n>a.run() : void\n>a.run : () => void\n>a : Cat | Dog\n>run : (a: Cat | Dog) => void\n}\n\nfunction f<T extends Cat | Dog>(a: T) {\n>f : <T extends Cat | Dog>(a: T) => void\n>T : any\n>a : T\n\n    a.run();\n>a.run() : void\n>a.run : () => void\n>a : Cat | Dog\n>run : (a: Cat | Dog) => void\n\n    run(a);\n>run(a) : void\n>run : (a: Cat | Dog) => void\n>a : Cat | Dog\n}\n"
typeParameterExtendsPrimitive,81,"//// [tests/cases/compiler/typeParameterExtendsPrimitive.ts] ////\n\n=== typeParameterExtendsPrimitive.ts ===\n// #14473\nfunction f<T extends number>() {\n>f : <T extends number>() => number\n>T : any\n\n    var t: T;\n>t : T\n\n    var v = {\n>v : {}\n>{        [t]: 0    } : { [x: number]: number; }\n\n        [t]: 0\n>[t] : any\n>t : T\n>0 : 0\n    }\n    return t + t;\n>t + t : number\n>t : T\n>t : T\n}\n\n// #15501\ninterface I { x: number }\n>x : any\n\ntype IdMap<T> = { [P in keyof T]: T[P] };\n>IdMap : IdMap\n>T : any\n>P : any\n\nfunction g<T extends I>(i: IdMap<T>) {\n>g : <T extends I>(i: IdMap<T>) => number\n>T : any\n>i : IdMap<T>\n\n    const n: number = i.x;\n>n : number\n>i.x : any\n>i : IdMap<T>\n>x : any\n\n    return i.x * 2;\n>i.x * 2 : number\n>i.x : any\n>i : IdMap<T>\n>x : any\n>2 : 2\n}\n\n// #17069\nfunction h<T extends Record<K, number>, K extends string>(array: T[], prop: K): number {\n>h : <T extends Record<K, number>, K extends string>(array: T[], prop: K) => number\n>T : any\n>K : any\n>array : T[]\n>prop : K\n\n    let result = 0;\n>result : number\n>0 : 0\n\n    for (const v of array) {\n>v : T\n>array : T[]\n\n        result += v[prop];\n>result += v[prop] : any\n>result : number\n>v[prop] : any\n>v : T\n>prop : K\n    }\n    return result;\n>result : number\n}\n\n"
typeParameterFixingWithConstraints,34,"//// [tests/cases/compiler/typeParameterFixingWithConstraints.ts] ////\n\n=== typeParameterFixingWithConstraints.ts ===\ninterface IBar {\n    [barId: string]: any;\n>barId : any\n}\n\ninterface IFoo {\n    foo<TBar extends IBar>(bar: TBar, bar1: (bar: TBar) => TBar, bar2: (bar: TBar) => TBar): TBar;\n>foo : IFoo\n>TBar : any\n>bar : TBar\n>bar1 : (bar: TBar) => TBar\n>bar : TBar\n>bar2 : (bar: TBar) => TBar\n>bar : TBar\n}\n\nvar foo: IFoo;\n>foo : IFoo\n\nfoo.foo({ bar: null }, bar => null, bar => null);\n>foo.foo({ bar: null }, bar => null, bar => null) : { bar: any; }\n>foo.foo : <TBar extends IBar>(bar: TBar, bar1: (bar: TBar) => TBar, bar2: (bar: TBar) => TBar) => TBar\n>foo : IFoo\n>foo : IFoo\n>{ bar: null } : { bar: null; }\n>bar : any\n>bar => null : (bar: { bar: any; }) => any\n>bar : { bar: any; }\n>bar => null : (bar: { bar: any; }) => any\n>bar : { bar: any; }\n\n"
typeParameterFixingWithContextSensitiveArguments,61,"//// [tests/cases/compiler/typeParameterFixingWithContextSensitiveArguments.ts] ////\n\n=== typeParameterFixingWithContextSensitiveArguments.ts ===\nfunction f<T, U>(y: T, f: (x: T) => U, x: T): [T, U] { return [y, f(x)]; }\n>f : <T, U>(y: T, f: (x: T) => U, x: T) => [T, U]\n>T : any\n>U : any\n>y : T\n>f : (x: T) => U\n>x : T\n>x : T\n>[y, f(x)] : [T, U]\n>y : T\n>f(x) : U\n>f : (x: T) => U\n>x : T\n\ninterface A { a: A; }\n>a : A\n\ninterface B extends A { b; }\n>b : B\n\nvar a: A, b: B;\n>a : A\n>b : B\n\nvar d = f(b, x => x.a, a); // type [A, A]\n>d : [A, A]\n>f(b, x => x.a, a) : [A, A]\n>f : <T, U>(y: T, f: (x: T) => U, x: T) => [T, U]\n>b : B\n>x => x.a : (x: B) => A\n>x : B\n>x.a : A\n>x : A\n>a : A\n>a : A\n\nvar d2 = f(b, x => x.a, null); // type [B, A]\n>d2 : [any, any]\n>f(b, x => x.a, null) : [any, any]\n>f : <T, U>(y: T, f: (x: T) => U, x: T) => [T, U]\n>b : B\n>x => x.a : (x: B) => any\n>x : B\n>x.a : any\n>x : any\n>a : A\n\nvar d3 = f(b, x => x.b, null); // type [B, any]\n>d3 : [any, any]\n>f(b, x => x.b, null) : [any, any]\n>f : <T, U>(y: T, f: (x: T) => U, x: T) => [T, U]\n>b : B\n>x => x.b : (x: B) => any\n>x : B\n>x.b : any\n>x : any\n>b : B\n\n"
typeParameterFixingWithContextSensitiveArguments2,42,"//// [tests/cases/compiler/typeParameterFixingWithContextSensitiveArguments2.ts] ////\n\n=== typeParameterFixingWithContextSensitiveArguments2.ts ===\nfunction f<T, U>(y: T, y1: U, p: (z: U) => T, p1: (x: T) => U): [T, U] { return [y, p1(y)]; }\n>f : <T, U>(y: T, y1: U, p: (z: U) => T, p1: (x: T) => U) => [T, U]\n>T : any\n>U : any\n>y : T\n>y1 : U\n>p : (z: U) => T\n>z : U\n>p1 : (x: T) => U\n>x : T\n>[y, p1(y)] : [T, U]\n>y : T\n>p1(y) : U\n>p1 : (x: T) => U\n>y : T\n\ninterface A { a: A; }\n>a : A\n\ninterface B extends A { b; }\n>b : B\n\ndeclare var a: A, b: B;\n>a : A\n>b : B\n\nvar d = f(a, b, x => x, x => x); // A => A not assignable to A => B\n>d : [A, B]\n>f(a, b, x => x, x => x) : [A, B]\n>f : <T, U>(y: T, y1: U, p: (z: U) => T, p1: (x: T) => U) => [T, U]\n>a : A\n>b : B\n>x => x : (x: B) => B\n>x : B\n>x : B\n>x => x : (x: A) => A\n>x : A\n>x : A\n\n"
typeParameterFixingWithContextSensitiveArguments3,44,"//// [tests/cases/compiler/typeParameterFixingWithContextSensitiveArguments3.ts] ////\n\n=== typeParameterFixingWithContextSensitiveArguments3.ts ===\nfunction f<T, U>(t1: T, u1: U, pf1: (u2: U) => T, pf2: (t2: T) => U): [T, U] { return [t1, pf2(t1)]; }\n>f : <T, U>(t1: T, u1: U, pf1: (u2: U) => T, pf2: (t2: T) => U) => [T, U]\n>T : any\n>U : any\n>t1 : T\n>u1 : U\n>pf1 : (u2: U) => T\n>u2 : U\n>pf2 : (t2: T) => U\n>t2 : T\n>[t1, pf2(t1)] : [T, U]\n>t1 : T\n>pf2(t1) : U\n>pf2 : (t2: T) => U\n>t1 : T\n\ninterface A { a: A; }\n>a : A\n\ninterface B extends A { b: B; }\n>b : B\n\ndeclare var a: A, b: B;\n>a : A\n>b : B\n\nvar d = f(a, b, u2 => u2.b, t2 => t2);\n>d : [A, B]\n>f(a, b, u2 => u2.b, t2 => t2) : [A, B]\n>f : <T, U>(t1: T, u1: U, pf1: (u2: U) => T, pf2: (t2: T) => U) => [T, U]\n>a : A\n>b : B\n>u2 => u2.b : (u2: B) => B\n>u2 : B\n>u2.b : B\n>u2 : B\n>b : B\n>t2 => t2 : (t2: A) => A\n>t2 : A\n>t2 : A\n\n"
typeParameterFixingWithContextSensitiveArguments4,43,"//// [tests/cases/compiler/typeParameterFixingWithContextSensitiveArguments4.ts] ////\n\n=== typeParameterFixingWithContextSensitiveArguments4.ts ===\nfunction f<T, U>(y: T, y1: U, p: (z: U) => T, p1: (x: T) => U): [T, U] { return [y, p1(y)]; }\n>f : <T, U>(y: T, y1: U, p: (z: U) => T, p1: (x: T) => U) => [T, U]\n>T : any\n>U : any\n>y : T\n>y1 : U\n>p : (z: U) => T\n>z : U\n>p1 : (x: T) => U\n>x : T\n>[y, p1(y)] : [T, U]\n>y : T\n>p1(y) : U\n>p1 : (x: T) => U\n>y : T\n\ninterface A { a: A; }\n>a : A\n\ninterface B extends A { b; }\n>b : B\n\nvar a: A, b: B;\n>a : A\n>b : B\n\nvar d = f(a, b, x => x, x => <any>x); // Type [A, B]\n>d : [A, B]\n>f(a, b, x => x, x => <any>x) : [A, B]\n>f : <T, U>(y: T, y1: U, p: (z: U) => T, p1: (x: T) => U) => [T, U]\n>a : A\n>b : B\n>x => x : (x: B) => B\n>x : B\n>x : B\n>x => <any>x : (x: A) => any\n>x : A\n><any>x : any\n>x : A\n\n"
typeParameterFixingWithContextSensitiveArguments5,44,"//// [tests/cases/compiler/typeParameterFixingWithContextSensitiveArguments5.ts] ////\n\n=== typeParameterFixingWithContextSensitiveArguments5.ts ===\nfunction f<T, U>(t1: T, u1: U, pf1: (u2: U) => T, pf2: (t2: T) => U): [T, U] { return [t1, pf2(t1)]; }\n>f : <T, U>(t1: T, u1: U, pf1: (u2: U) => T, pf2: (t2: T) => U) => [T, U]\n>T : any\n>U : any\n>t1 : T\n>u1 : U\n>pf1 : (u2: U) => T\n>u2 : U\n>pf2 : (t2: T) => U\n>t2 : T\n>[t1, pf2(t1)] : [T, U]\n>t1 : T\n>pf2(t1) : U\n>pf2 : (t2: T) => U\n>t1 : T\n\ninterface A { a: A; }\n>a : A\n\ninterface B extends A { b: any; }\n>b : B\n\nvar a: A, b: B;\n>a : A\n>b : B\n\nvar d = f(a, b, u2 => u2.b, t2 => t2);\n>d : [A, B]\n>f(a, b, u2 => u2.b, t2 => t2) : [A, B]\n>f : <T, U>(t1: T, u1: U, pf1: (u2: U) => T, pf2: (t2: T) => U) => [T, U]\n>a : A\n>b : B\n>u2 => u2.b : (u2: B) => any\n>u2 : B\n>u2.b : any\n>u2 : B\n>b : B\n>t2 => t2 : (t2: A) => A\n>t2 : A\n>t2 : A\n\n"
