divergentAccessorsTypes6,89,"//// [tests/cases/compiler/divergentAccessorsTypes6.ts] ////\n\n=== divergentAccessorsTypes6.ts ===\nexport {};\n\ninterface Element {\n    get style(): CSSStyleDeclaration;\n>style : any\n\n    set style(cssText: string);\n>style : any\n>cssText : string\n}\n\ndeclare const element: Element;\n>element : Element\n\nelement.style = ""color: red"";\n>element.style = ""color: red"" : ""color: red""\n>element.style : any\n>element : Element\n>style : any\n>""color: red"" : ""color: red""\n\nelement.style.animationTimingFunction;\n>element.style.animationTimingFunction : any\n>element.style : any\n>element : Element\n>style : any\n>animationTimingFunction : any\n\nelement.style = element.style; // error\n>element.style = element.style : any\n>element.style : any\n>element : Element\n>style : any\n>element.style : any\n>element : Element\n>style : any\n\n// Now that we don't check for getter/setter assignability, we should\n// ensure the setter annotation is actually checked even if it's never observed.\n\ntype Fail<T extends never> = T;\n>Fail : Fail\n>T : any\n\ninterface I1 {\n    get x(): number;\n>x : any\n\n    set x(value: Fail<string>);\n>x : any\n>value : string\n}\nconst o1 = {\n>o1 : { x: number; }\n>{    get x(): number { return 0; },    set x(value: Fail<string>) {}} : { x: number; }\n\n    get x(): number { return 0; },\n>x : any\n\n    set x(value: Fail<string>) {}\n>x : any\n>value : string\n}\n\n// A setter annotation still implies the getter return type.\n\nconst o2 = {\n>o2 : { p1: string; p2: number; }\n>{    get p1() { return 0; }, // error - no annotation means type is implied from the setter annotation    set p1(value: string) {},    get p2(): number { return 0; }, // ok - explicit annotation    set p2(value: string) {},} : { p1: string; p2: number; }\n\n    get p1() { return 0; }, // error - no annotation means type is implied from the setter annotation\n>p1 : any\n\n    set p1(value: string) {},\n>p1 : any\n>value : string\n\n    get p2(): number { return 0; }, // ok - explicit annotation\n>p2 : any\n\n    set p2(value: string) {},\n>p2 : any\n>value : string\n\n};\n\n"
divergentAccessorsTypes7,62,"//// [tests/cases/compiler/divergentAccessorsTypes7.ts] ////\n\n=== divergentAccessorsTypes7.ts ===\nclass Test<S> {\n>Test : typeof Test\n>S : any\n\n    constructor() {}\n\n    set value(value: string | ((item: S) => string)) {}\n>value : any\n>value : string | ((item: S) => string)\n>item : S\n\n    get value(): string {\n>value : any\n\n        return null!;\n>null! : never\n    }\n\n    // -- Replacing the getter such that the getter/setter types match, removes the error:\n    // get value(): string | ((item: S) => string) {\n    //     return null!;\n    // }\n\n    // -- Or, replacing the setter such that a concrete type is used, removes the error:\n    // set value(value: string | ((item: { property: string }) => string)) {}\n}\n\nconst a = new Test<{\n>a : Test<{ property: string; }>\n>new Test<{    property: string}>( : Test<{ property: string; }>\n>Test : typeof Test\n\n    property: string\n>property : any\n\n}>();\n\na.value = (item) => item.property\n>a.value = (item) => item.property : (item: { property: string; }) => string\n>a.value : string\n>a : Test<{ property: string; }>\n>value : any\n>(item) => item.property : (item: { property: string; }) => string\n>item : { property: string; }\n>item.property : string\n>item : { property: string; }\n>property : any\n\na['value'] = (item) => item.property\n>a['value'] = (item) => item.property : (item: { property: string; }) => string\n>a['value'] : string\n>a : Test<{ property: string; }>\n>'value' : ""value""\n>(item) => item.property : (item: { property: string; }) => string\n>item : { property: string; }\n>item.property : string\n>item : { property: string; }\n>property : any\n\n"
